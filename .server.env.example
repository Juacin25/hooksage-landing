# Solo servidor. Nunca usar prefijo PUBLIC_ para credenciales.
NODE_ENV=production
HOST=0.0.0.0
PORT=8787
# En Tenki: ruta dentro del volumen persistente, fuera de dist/.
DATABASE_PATH=/data/hooksage/waitlist.sqlite
# Orígenes exactos separados por coma. Incluir la URL HTTPS devuelta por Tenki.
ALLOWED_ORIGINS=https://hooksage.com,https://www.hooksage.com
# Solo detrás del proxy de Tenki, sin acceso directo al puerto del servidor.
TRUST_PROXY=true
# Aviso por email de cada registro nuevo (Resend, plan gratis). Sin clave, solo se guarda en la base.
# La cuenta de Resend debe ser de NOTIFY_EMAIL_TO para poder usar onboarding@resend.dev sin verificar dominio.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=hooksage.app@gmail.com
# Opcional, solo con hooksage.com verificado en Resend: Hooksage <avisos@hooksage.com>
NOTIFY_EMAIL_FROM=
