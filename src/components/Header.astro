---
import Logo from "./Logo.astro";
import {
  localeFromPath,
  translator,
  homePath,
  waitlistHref,
  alternatePath,
} from "../lib/i18n";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const home = homePath(lang);
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav aria-label={t("Navegación principal")}>
      <a href={home + "#marca"}>{t("Marca e ideas")}</a>
      <a href={home + "#como-funciona"}>{t("Cómo funciona")}</a>
      <a href={home + "#tonos"}>{t("Acabados")}</a>
      <a href={home + "#precio"}>{t("Precio")}</a>
      <a href={home + "#preguntas"}>{t("Preguntas")}</a>
    </nav>
    <div class="header-actions">
      <div
        class="language-switch"
        role="group"
        aria-label={lang === "en" ? "Language" : "Idioma"}
      >
        <a
          href={alternatePath(Astro.url.pathname, "es")}
          lang="es"
          hreflang="es"
          aria-current={lang === "es" ? "page" : undefined}
          aria-label="Español"
          data-language-link
        >
          ES
        </a>
        <a
          href={alternatePath(Astro.url.pathname, "en")}
          lang="en"
          hreflang="en"
          aria-current={lang === "en" ? "page" : undefined}
          aria-label="English"
          data-language-link
        >
          EN
        </a>
      </div>
      <a
        class="hs-btn hs-btn--primary hs-btn--sm header-cta"
        href={waitlistHref(Astro.url.pathname)}
        data-waitlist-cta
        data-cta-location="header"
      >
        <span class="header-cta-full">{t("Probar con mi video")}</span>
        <span class="header-cta-short">{lang === "en" ? "Try" : "Probar"}</span>
      </a>
    </div>
  </div>
</header>
<script>
  // Keep the shared section and campaign URL when changing language.
  const updateLanguageLinks = () => {
    document
      .querySelectorAll<HTMLAnchorElement>("[data-language-link]")
      .forEach((link) => {
        const target = new URL(link.href);
        target.search = location.search;
        target.hash = location.hash;
        link.href = target.href;
      });
  };
  updateLanguageLinks();
  window.addEventListener("hashchange", updateLanguageLinks);
  window.addEventListener("popstate", updateLanguageLinks);
</script>
