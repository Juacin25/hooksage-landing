---
import Icon from "./Icon.astro";
import VideoCard from "./VideoCard.astro";
import { businesses } from "../data/content";
---

<section
  class="section examples examples--gallery"
  id="ejemplos"
  aria-labelledby="examples-title"
>
  <div class="container">
    <div class="section-heading section-heading--row">
      <div>
        <p class="overline eyebrow">Para quién es</p>
        <h2 class="heading-1" id="examples-title">
          Un equipo chico.
          <br />
          Mucho para contar.
        </h2>
      </div>
      <p class="body muted">
        Si ya tenés qué decir, la edición no debería frenar lo que publicás.
        Estos son algunos contenidos con los que podés empezar.
      </p>
    </div>
    <nav class="business-rail" aria-label="Explorar ideas por tipo de equipo">
      {businesses.map((business) => (
        <a href={`#ejemplo-${business.slug}`} class="hs-btn hs-btn--secondary">
          <Icon name={business.icon} size={20} />
          {business.name}
        </a>
      ))}
    </nav>
    <div class="examples-grid">
      {businesses.map((business) => (
        <article class="example-card" id={`ejemplo-${business.slug}`}>
          <VideoCard
            tone={business.tone}
            business={business.singular}
            poster={business.poster}
            headline={business.sample}
            compact
          />
          <div class="example-copy">
            <h3 class="heading-3">
              <a href={`/videos-para-${business.slug}/`}>
                {business.name}
                <Icon name="arrow" size={20} />
              </a>
            </h3>
            <p class="small muted">Material con el que podés empezar:</p>
            <ul class="small">
              {business.ideas.map((idea) => (
                <li>
                  <Icon name="check" size={16} />
                  {idea}
                </li>
              ))}
            </ul>
            <a
              class="text-link small example-more"
              href={`/videos-para-${business.slug}/`}
            >
              Ver ideas para mi equipo
              <Icon name="arrow" size={16} />
            </a>
          </div>
        </article>
      ))}
    </div>
    <p class="small muted examples-note">
      Fotografías de referencia. No son videos editados por Hooksage ni
      testimonios de clientes.
    </p>
  </div>
</section>
