<script is:inline>
  (() => {
    const storageKey = "hooksage:campaign";
    const ttl = 30 * 60 * 1000;
    const utmKeys = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_content",
      "utm_term",
    ];
    const paths = new Set([
      "/",
      "/en/",
      "/privacidad/",
      "/terminos/",
      "/en/privacy/",
      "/en/terms/",
      "/en/videos-for-startups/",
      "/en/videos-for-small-businesses/",
      "/en/videos-for-personal-brands/",
      "/en/videos-for-marketing-teams/",
      "/videos-para-startups/",
      "/videos-para-pymes/",
      "/videos-para-marca-personal/",
      "/videos-para-equipos-de-marketing/",
    ]);
    const path = paths.has(location.pathname) ? location.pathname : "/";
    const validTag = (value) =>
      typeof value === "string" && /^[A-Za-z0-9_.-]{1,80}$/.test(value);
    let context = { landing_path: path };
    let capturedAt = Date.now();
    let marketingActive = false;
    let initialized = false;
    function clearAttribution() {
      context = { landing_path: path };
      capturedAt = Date.now();
      try {
        // Removing stale attribution needs no read of previously saved campaign data.
        sessionStorage.removeItem(storageKey);
      } catch {}
    }
    function captureAttribution() {
      const params = new URLSearchParams(location.search);
      const campaign = {};
      for (const key of utmKeys) {
        const value = params.get(key);
        if (validTag(value)) campaign[key] = value;
      }
      context = { landing_path: path };
      capturedAt = Date.now();
      const hasCampaign = Object.keys(campaign).length > 0;
      try {
        const saved = JSON.parse(sessionStorage.getItem(storageKey) || "null");
        const validSaved =
          saved &&
          typeof saved.captured_at === "number" &&
          saved.captured_at <= Date.now() &&
          Date.now() - saved.captured_at < ttl &&
          paths.has(saved.landing_path);
        const sameCampaign =
          validSaved && utmKeys.every((key) => campaign[key] === saved[key]);
        if (validSaved && (!hasCampaign || sameCampaign)) {
          context = { landing_path: saved.landing_path };
          capturedAt = saved.captured_at;
          for (const key of utmKeys)
            if (validTag(saved[key])) context[key] = saved[key];
        } else if (hasCampaign) context = { landing_path: path, ...campaign };
      } catch {
        if (hasCampaign) context = { landing_path: path, ...campaign };
      }
      try {
        sessionStorage.setItem(
          storageKey,
          JSON.stringify({ ...context, captured_at: capturedAt }),
        );
      } catch {}
    }
    function synchronizeConsent() {
      const allowed = Boolean(window.HooksageConsent?.allowsMarketing());
      if (allowed && !marketingActive) captureAttribution();
      if (!allowed && (marketingActive || !initialized)) clearAttribution();
      marketingActive = allowed;
      initialized = true;
      return allowed;
    }
    const getAttribution = () => {
      if (!synchronizeConsent()) return { landing_path: path };
      if (Date.now() - capturedAt >= ttl) clearAttribution();
      return { ...context };
    };
    window.addEventListener("hooksage:consent-changed", synchronizeConsent);
    synchronizeConsent();
    const eventNames = new Set([
      "waitlist_landing_view",
      "waitlist_cta_click",
      "waitlist_form_start",
      "waitlist_form_error",
      "generate_lead",
    ]);
    const track = (name, details = {}) => {
      if (!eventNames.has(name)) return;
      const safeDetails = {};
      for (const key of ["cta_location", "error_type"])
        if (
          typeof details[key] === "string" &&
          /^[a-z_]{1,40}$/.test(details[key])
        )
          safeDetails[key] = details[key];
      const event = {
        event: name,
        form_id: "hooksage_waitlist",
        page_path: path,
        ...getAttribution(),
        ...safeDetails,
      };
      try {
        window.dispatchEvent(
          new CustomEvent("hooksage:funnel", { detail: event }),
        );
      } catch {}
      try {
        if (
          window.HooksageConsent?.allowsMarketing() &&
          Array.isArray(window.dataLayer)
        )
          window.dataLayer.push(event);
      } catch {}
    };
    window.HooksageFunnel = { getAttribution, track };
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const link = event.target.closest("a[data-waitlist-cta]");
      if (link)
        track("waitlist_cta_click", {
          cta_location: link.dataset.ctaLocation || "content",
        });
    });
    track("waitlist_landing_view");
  })();
</script>
