---
import { localeFromPath, translator, homePath } from "../lib/i18n";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const { footer = false } = Astro.props;
---

<a
  href={homePath(lang)}
  class:list={["logo", { "logo--footer": footer }]}
  aria-label={t("Hooksage, inicio")}
>
  <img
    class="logo-light"
    src="/logos/hooksage-lockup.svg"
    alt="hooksage"
    width="156"
    height="40"
    loading={footer ? "lazy" : "eager"}
  />
  <img
    class="logo-dark"
    src="/logos/hooksage-lockup-dark.svg"
    alt="hooksage"
    width="156"
    height="40"
    loading={footer ? "lazy" : "eager"}
  />
</a>
