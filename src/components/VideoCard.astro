---
import { localeFromPath, translator, waitlistHref } from "../lib/i18n";
import Icon from "./Icon.astro";
import { referenceMedia, mediaSizes } from "../data/media";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
interface Props {
  tone?: string;
  business?: string;
  poster?: string;
  headline?: string;
  lift?: boolean;
  compact?: boolean;
  dark?: boolean;
  eager?: boolean;
  source?: string;
}
const {
  tone = t("A cámara"),
  business = t("Tu equipo"),
  poster = "founder-interview",
  headline = t("Una idea que se entiende."),
  lift = false,
  compact = false,
  dark = false,
  eager = false,
  source,
}: Props = Astro.props;
const resolvedPoster = referenceMedia[poster] ? poster : "founder-interview";
const media = referenceMedia[resolvedPoster];
const imageSizes = mediaSizes(media);
// TODO: replace reference photography with authorized customer video and its real poster.
const formHref = waitlistHref(Astro.url.pathname);
---

<figure
  class:list={[
    "hs-video media-card",
    { "hs-video--lift": lift, "hs-video--compact": compact },
  ]}
  data-theme={dark ? "dark" : undefined}
>
  <div class="media-window" data-media-kind={media.kind}>
    {source ? (
      <video
        class="hs-video__media"
        src={source}
        poster={`/media/${resolvedPoster}.webp`}
        preload="none"
        muted
        playsinline
        controls
        width="360"
        height="640"
        aria-label={
          (lang === "en" ? "Video for " : "Video para ") +
          business +
          ": " +
          tone
        }
      />
    ) : (
      <picture>
        <source
          data-sample-source
          type="image/avif"
          srcset={`/media/${resolvedPoster}-360.avif 360w, /media/${resolvedPoster}.avif ${media.width}w`}
          sizes={imageSizes}
        />
        <img
          class="hs-video__media"
          data-sample-photo
          src={`/media/${resolvedPoster}.webp`}
          srcset={`/media/${resolvedPoster}-360.webp 360w, /media/${resolvedPoster}.webp ${media.width}w`}
          sizes={imageSizes}
          alt={t(media.alt)}
          width={media.width}
          height={media.height}
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={eager ? "high" : undefined}
          style={`object-position:${media.position}`}
        />
      </picture>
    )}
    <div class="hs-video__top">
      <span class="hs-badge hs-badge--brand" data-sample-badge>
        {tone}
      </span>
      <span class="hs-video__time" aria-label={t("Formato vertical 9:16")}>
        9:16
      </span>
    </div>
    {!source && (
      <span class="media-reference" data-sample-label>
        {t(media.label)}
      </span>
    )}
  </div>
  <figcaption class="media-caption">
    <div>
      <span class="media-business small">{business}</span>
      <span class="poster-headline" data-sample-headline>
        {headline}
      </span>
    </div>
    {!compact && (
      <a
        class="media-card-cta"
        href={formHref}
        data-waitlist-cta
        data-cta-location="gallery"
        aria-label={
          (lang === "en"
            ? "Request a free edit for "
            : "Quiero probar Hooksage para ") + business.toLowerCase()
        }
      >
        <Icon name="arrow" size={20} />
      </a>
    )}
  </figcaption>
</figure>
