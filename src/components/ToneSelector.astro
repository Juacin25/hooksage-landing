---
import { localeFromPath, translator } from "../lib/i18n";
import { productFor } from "../data/product";
import Icon from "./Icon.astro";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const { finishes } = productFor(lang);
---

<section class="section finish-section" id="tonos" aria-labelledby="tone-title">
  <div class="container">
    <div class="finish-heading">
      <div>
        <p class="overline eyebrow">{finishes.eyebrow}</p>
        <h2 class="heading-1" id="tone-title">
          {finishes.title}
        </h2>
      </div>
      <p class="body muted">{finishes.intro}</p>
    </div>
    <div class="finish-list">
      {finishes.items.map((item, index) => (
        <article class="finish-row" data-finish>
          <div class="finish-name">
            <span class="small muted" aria-hidden="true">
              0{index + 1}
            </span>
            <h3>{item.name}</h3>
          </div>
          <div>
            <h4 class="heading-3">{item.title}</h4>
            <p class="body muted">{item.description}</p>
          </div>
          <p class="small muted finish-detail">{item.detail}</p>
        </article>
      ))}
    </div>
    <div class="finish-footer">
      <p class="small muted">{finishes.note}</p>
      <a
        class="text-link small"
        href="#empezar"
        data-waitlist-cta
        data-cta-location="tones"
      >
        {t("Quiero probar Hooksage")}
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>
<style>
  .finish-section {
    background: var(--surface-sunken);
    border-block: 1px solid var(--border);
  }
  .finish-heading {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-8);
    align-items: end;
  }
  .finish-heading h2 {
    margin-top: var(--space-3);
    max-width: 560px;
  }
  .finish-heading > p {
    margin: 0;
    max-width: 460px;
  }
  .finish-row {
    display: grid;
    grid-template-columns: 0.85fr 1.4fr 0.8fr;
    gap: var(--space-8);
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
    align-items: start;
  }
  .finish-name {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }
  .finish-name h3 {
    font-family: var(--font-display);
    font-size: 29px;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--primary);
  }
  .finish-row h4 {
    margin: 0 0 var(--space-2);
  }
  .finish-row p {
    margin: 0;
    line-height: 1.65;
  }
  .finish-detail {
    padding-top: var(--space-1);
  }
  .finish-footer {
    border-top: 1px solid var(--border);
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: var(--space-8);
    padding-top: var(--space-6);
  }
  .finish-footer p {
    margin: 0;
    max-width: 680px;
  }
  .finish-footer a {
    flex-shrink: 0;
  }
  @media (max-width: 800px) {
    .finish-heading {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .finish-row {
      grid-template-columns: 1fr 2fr;
    }
    .finish-detail {
      grid-column: 2;
    }
  }
  @media (max-width: 520px) {
    .finish-row {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .finish-detail {
      grid-column: 1;
    }
    .finish-footer {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
