---
import { localeFromPath, translator } from "../lib/i18n";
import Icon from "./Icon.astro";
import VideoSamples from "./VideoSamples.astro";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
---

<section class="hero hero--showcase section" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-intro">
      <div class="hero-titlebox">
        <span class="hs-badge hs-badge--accent">
          <span class="hs-badge__dot" aria-hidden="true"></span>
          {t("Piloto en desarrollo")}
        </span>
        <h1 class="display-xl" id="hero-title">
          <span class="hero-title-line">{t("De tu video en crudo")}</span>{" "}
          <span>{t("a un short editado.")}</span>
        </h1>
      </div>
      <div class="hero-pitch">
        <p class="body-l muted">
          {t(
            "Nos pasás lo que grabaste con el celular. Te devolvemos un video vertical con cortes, encuadre y subtítulos para Reels, TikTok o Shorts.",
          )}
        </p>
        <div class="hero-actions">
          <a
            class="hs-btn hs-btn--primary"
            href="#empezar"
            data-waitlist-cta
            data-cta-location="hero"
          >
            {t("Probar con mi video")}
            <Icon name="arrow" />
          </a>
          <a class="text-link" href="#ver-edicion">
            {t("Ver el antes y después")}
            <Icon name="arrow" size={18} />
          </a>
        </div>
        <p class="small reassurance">
          <Icon name="check" size={16} />
          {t("Primera edición gratis. Coordinamos por email.")}
        </p>
      </div>
    </div>
    <VideoSamples />
    <div class="hero-footnote">
      <span class="overline">{t("Del material al contenido")}</span>
      <span>
        {t("TikTok")}
        <span class="dot-separator" aria-hidden="true">
          ·
        </span>
        {t("Instagram Reels")}
        <span class="dot-separator" aria-hidden="true">
          ·
        </span>
        {t("YouTube Shorts")}
      </span>
      <span class="small">
        <Icon name="location" size={18} />
        {t("Hecho en el Río de la Plata")}
      </span>
    </div>
  </div>
</section>
