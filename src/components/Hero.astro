---
import { localeFromPath, translator } from "../lib/i18n";
import Icon from "./Icon.astro";
import VideoCard from "./VideoCard.astro";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const showcase = [
  {
    tone: "A cámara",
    business: "Startups",
    poster: "founder-interview",
    headline: "Tu producto, bien contado.",
  },
  {
    tone: "Demo de producto",
    business: "Drivo",
    poster: "drivo-product",
    headline: "Mostrá cómo funciona.",
  },
  {
    tone: "Educativo",
    business: "Marca personal",
    poster: "creator-podcast",
    headline: "Tu experiencia, en un Reel.",
  },
  {
    tone: "Campaña",
    business: "Equipos de marketing",
    poster: "product-campaign",
    headline: "Tu próximo lanzamiento.",
  },
].map((sample) => ({
  ...sample,
  tone: t(sample.tone),
  business: t(sample.business),
  headline: t(sample.headline),
}));
---

<section class="hero hero--showcase section" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-intro">
      <div class="hero-titlebox">
        <span class="hs-badge hs-badge--accent">
          <span class="hs-badge__dot" aria-hidden="true"></span>
          {t("Acceso anticipado")}
        </span>
        <h1 class="display-xl" id="hero-title">
          <span class="hero-title-line">{t("Más videos.")}</span>{" "}
          <span>{t("Menos horas editando.")}</span>
        </h1>
      </div>
      <div class="hero-pitch">
        <p class="body-l muted">
          {t(
            "Pasá tu material sin editar y recibí videos de 15 segundos con cortes, zooms y subtítulos. Para startups y empresas chicas que necesitan publicar, sin dedicarle horas a la edición.",
          )}
        </p>
        <div class="hero-actions">
          <a
            class="hs-btn hs-btn--primary"
            href="#empezar"
            data-waitlist-cta
            data-cta-location="hero"
          >
            {t("Quiero probar Hooksage")}
            <Icon name="arrow" />
          </a>
          <a class="text-link" href="#ejemplos">
            {t("Ver para quién es")}
            <Icon name="arrow" size={18} />
          </a>
        </div>
        <p class="small reassurance">
          <Icon name="check" size={16} />
          {t("Primer video gratis al registrarse.")}
        </p>
      </div>
    </div>
    <div class="showcase-window">
      <div class="showcase-toolbar">
        <span class="label">
          <span class="studio-dot" aria-hidden="true"></span>
          {t("Tu material. Una edición con criterio.")}
        </span>
        <span class="small muted showcase-format">{t("9:16 / 15 s")}</span>
      </div>
      <div
        class="showcase-grid"
        aria-label={t("Formatos de contenido para tu equipo")}
      >
        {showcase.map((sample, index) => (
          <div class="showcase-card">
            <VideoCard {...sample} lift={index === 1} eager={index === 0} />
          </div>
        ))}
      </div>
      <div class="showcase-footer">
        <p class="small muted">
          {t(
            "Referencias de formatos, ilustradas con fotografías. Los videos se crearán con tu propio material.",
          )}
        </p>
        <span class="small muted swipe-hint">
          {t("Deslizá para explorar")}
          <Icon name="arrow" size={16} />
        </span>
      </div>
    </div>
    <div class="hero-footnote">
      <span class="overline">{t("Del material al contenido")}</span>
      <span>
        {t("TikTok")}
        <span class="dot-separator" aria-hidden="true">
          ·
        </span>
        {t("Instagram Reels")}
        <span class="dot-separator" aria-hidden="true">
          ·
        </span>
        {t("YouTube Shorts")}
      </span>
      <span class="small">
        <Icon name="location" size={18} />
        {t("Hecho en el Río de la Plata")}
      </span>
    </div>
  </div>
</section>
