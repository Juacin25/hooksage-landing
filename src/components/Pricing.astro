---
import { localeFromPath, translator } from "../lib/i18n";
import Icon from "./Icon.astro";
import SubscriptionPlanCard from "./SubscriptionPlanCard.astro";
import {
  plansFor,
  packsFor,
  unitPriceFor,
  type BillingPeriod,
} from "../data/plan";
import { applicationUrl, contactUrl, paidPlansAvailable } from "../lib/config";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const purchaseHref = applicationUrl || contactUrl;
const purchaseLabel = applicationUrl
  ? paidPlansAvailable
    ? t("Ir a la aplicación")
    : lang === "en"
      ? "Create a free account"
      : "Crear cuenta gratis"
  : t("Consultar acceso");
const localPlans = plansFor(lang);
const localPacks = packsFor(lang);
const billingPeriods: { id: BillingPeriod; label: string; intro: string }[] = [
  {
    id: "monthly",
    label: t("Mensual"),
    intro: t("Un cupo de videos cada semana. Un solo cobro al mes."),
  },
  {
    id: "annual",
    label: t("Anual"),
    intro: t("El mismo cupo semanal, con un solo pago al año."),
  },
];
const features = [
  "Cortes, zooms y subtítulos",
  "MP4 vertical para tus redes",
  "Ideas de contenido y tu marca",
].map(t);
---

<section class="section pricing" id="precio" aria-labelledby="price-title">
  <div class="container">
    <div class="section-heading centered">
      <p class="overline eyebrow">{t("Contenido a tu ritmo")}</p>
      <h2 class="heading-1" id="price-title">
        {t("Una campaña. O todas las semanas.")}
      </h2>
      <p class="body muted">
        {t("Packs para una campaña. Suscripciones para publicar cada semana.")}
        <br />
        {t("Elegí pagar por mes o por año.")}
      </p>
    </div>
    <div
      class="pricing-tabs"
      role="tablist"
      aria-label={t("Modalidad de pago")}
      hidden
      data-pricing-tabs
    >
      <button
        type="button"
        id="pricing-tab-packs"
        role="tab"
        aria-selected="true"
        aria-controls="pricing-panel-packs"
        tabindex="0"
      >
        {t("Packs")}
      </button>
      <button
        type="button"
        id="pricing-tab-subscriptions"
        role="tab"
        aria-selected="false"
        aria-controls="pricing-panel-subscriptions"
        tabindex="-1"
      >
        {t("Suscripción")}
      </button>
    </div>
    <div
      class="pricing-panel"
      id="pricing-panel-packs"
      role="tabpanel"
      aria-labelledby="pricing-tab-packs"
      data-pricing-panel
    >
      <p class="pricing-panel-intro muted">
        {t("Para cuando necesitás videos, sin una cuota mensual.")}
      </p>
      <div class="pricing-grid">
        {localPacks.map((pack, index) => (
          <article
            class:list={[
              "hs-card hs-price",
              { "hs-price--featured": index === 1 },
            ]}
            aria-label={pack.name}
          >
            <div class="price-header">
              <h3 class="hs-price__name">{pack.name}</h3>
            </div>
            <p class="small muted price-description">{pack.description}</p>
            <div class="hs-price__amount">
              <span class="price-currency">{t("US$")}</span>
              {pack.priceUSD}
              <span class="hs-price__period">{t("pago único")}</span>
            </div>
            <div class="price-quota">
              <p>
                <strong>{pack.exports}</strong>
                <span>{t("videos en el pack")}</span>
              </p>
              <p class="price-quota-detail muted">
                ≈ US${unitPriceFor(pack.priceUSD, pack.exports, lang)}{" "}
                {t("por video")}
              </p>
            </div>
            <ul class="hs-price__list">
              {features.map((feature) => (
                <li>
                  <Icon name="check" />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
            <p class="small muted">
              {t("Un solo pago. Sin renovación automática.")}
            </p>
            <a
              class:list={[
                "hs-btn",
                index === 1 ? "hs-btn--primary" : "hs-btn--secondary",
              ]}
              href={purchaseHref}
            >
              {purchaseLabel}
              <Icon name="arrow" />
            </a>
          </article>
        ))}
      </div>
    </div>
    <div
      class="pricing-panel"
      id="pricing-panel-subscriptions"
      role="tabpanel"
      aria-labelledby="pricing-tab-subscriptions"
      data-pricing-panel
    >
      <div
        class="pricing-tabs billing-tabs"
        role="tablist"
        aria-label={t("Facturación de la suscripción")}
        hidden
        data-billing-tabs
      >
        {billingPeriods.map((period, index) => (
          <button
            type="button"
            id={"pricing-tab-" + period.id}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={"pricing-billing-panel-" + period.id}
            tabindex={index === 0 ? 0 : -1}
          >
            {period.label}
          </button>
        ))}
      </div>
      {billingPeriods.map((period) => (
        <div
          class="billing-panel"
          id={"pricing-billing-panel-" + period.id}
          role="tabpanel"
          aria-labelledby={"pricing-tab-" + period.id}
          data-billing-panel
        >
          <p class="pricing-panel-intro muted">{period.intro}</p>
          <div class="pricing-grid">
            {localPlans.map((plan, index) => (
              <SubscriptionPlanCard
                plan={plan}
                pack={localPacks[index]}
                period={period.id}
                language={lang}
                featured={index === 1}
                features={features}
                purchaseHref={purchaseHref}
                purchaseLabel={purchaseLabel}
              />
            ))}
          </div>
        </div>
      ))}
      <p class="small muted unit-price-note">
        {t(
          "Precio por video estimado al usar todo el cupo: 52 semanas al año (4,33 por mes, en promedio). Cada plan se compara con el pack de su mismo nivel; el ahorro depende del uso.",
        )}
      </p>
    </div>
    <p class="small muted pricing-note">
      {t(
        "Precios en dólares. Packs válidos durante 90 días. En las suscripciones, el cupo se renueva cada siete días y no se acumula.",
      )}
      <br />
      {paidPlansAvailable
        ? t(
            "El registro de cuenta y la compra se realizan en la aplicación, separada de este sitio.",
          )
        : lang === "en"
          ? "Paid plans and packs are not enabled yet. You can create a free account in the app; registration does not activate a subscription or a charge."
          : "Los planes y packs de pago todavía no están habilitados. Podés crear una cuenta gratis en la aplicación; registrarte no activa una suscripción ni un cobro."}
      <br />
      {t("Sumarte a la prueba no activa un plan. Sin pago ni tarjeta.")}{" "}
      <a href="#empezar">{t("Solicitar mi edición gratis")}</a> ·{" "}
      <a href={lang === "en" ? "/en/terms/" : "/terminos/"}>
        {t("Términos y condiciones")}
      </a>
    </p>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-pricing-tabs], [data-billing-tabs]")
    .forEach((control) => {
      const tabs = Array.from(control.children).filter(
        (element): element is HTMLButtonElement =>
          element instanceof HTMLButtonElement &&
          element.getAttribute("role") === "tab",
      );
      const select = (selected: HTMLButtonElement) =>
        tabs.forEach((tab) => {
          const active = tab === selected;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(
            tab.getAttribute("aria-controls")!,
          );
          if (panel) panel.hidden = !active;
        });
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (event) => {
          let next: number | undefined;
          if (event.key === "ArrowRight" || event.key === "ArrowDown")
            next = (index + 1) % tabs.length;
          if (event.key === "ArrowLeft" || event.key === "ArrowUp")
            next = (index - 1 + tabs.length) % tabs.length;
          if (event.key === "Home") next = 0;
          if (event.key === "End") next = tabs.length - 1;
          if (next !== undefined) {
            event.preventDefault();
            select(tabs[next]);
            tabs[next].focus();
          }
        });
      });
      select(tabs[0]);
      control.hidden = false;
    });
</script>

<style>
  .pricing-tabs {
    display: flex;
    gap: 4px;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 28px;
    padding: 4px;
    background: var(--surface-sunken);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .pricing-tabs[hidden],
  .pricing-panel[hidden],
  .billing-panel[hidden] {
    display: none;
  }
  .pricing-tabs button {
    min-height: 44px;
    padding: 8px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-muted);
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .pricing-tabs button[aria-selected="true"] {
    background: var(--surface-raised);
    border-color: var(--border);
    color: var(--ink);
  }
  .billing-tabs {
    background: transparent;
    padding: 3px;
  }
  .billing-tabs button {
    min-height: 38px;
    padding: 6px 22px;
  }
  .pricing-panel + .pricing-panel,
  .billing-panel + .billing-panel {
    margin-top: 36px;
  }
  .pricing-panel[hidden] + .pricing-panel,
  .billing-panel[hidden] + .billing-panel {
    margin-top: 0;
  }
  .pricing-panel-intro {
    text-align: center;
    font-size: 14px;
    margin-bottom: 28px;
  }
  .pricing-grid .price-quota {
    display: block;
  }
  .price-quota > p:first-child {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .price-quota .price-quota-detail {
    font-size: 12px;
    line-height: 20px;
    margin-top: 8px;
  }
  .pricing-grid .hs-price--featured {
    border: 2px solid var(--primary);
  }
  .pricing-grid .hs-price__amount {
    flex-wrap: wrap;
    white-space: normal;
    row-gap: 8px;
  }
  .unit-price-note {
    max-width: 780px;
    margin: 24px auto 0;
    text-align: center;
  }
  @media (max-width: 400px) {
    .pricing-tabs button {
      padding-inline: 18px;
    }
    .pricing-grid .hs-price__amount {
      font-size: 44px;
    }
    .pricing-grid .hs-price__period {
      flex-basis: 100%;
      margin-left: 0;
    }
  }
</style>
