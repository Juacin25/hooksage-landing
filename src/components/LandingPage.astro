---
import Layout from "../layouts/Layout.astro";
import Hero from "./Hero.astro";
import StoryMotion from "./StoryMotion.astro";
import ProductCapabilities from "./ProductCapabilities.astro";
import ScrollWorkflow from "./ScrollWorkflow.astro";
import VideoSamples from "./VideoSamples.astro";
import ToneSelector from "./ToneSelector.astro";
import Examples from "./Examples.astro";
import Stats from "./Stats.astro";
import Pricing from "./Pricing.astro";
import FreeVideoForm from "./FreeVideoForm.astro";
import FAQ from "./FAQ.astro";
import FinalCTA from "./FinalCTA.astro";
import { localeFromPath } from "../lib/i18n";
const en = localeFromPath(Astro.url.pathname) === "en";
---

<Layout
  variant="story"
  title={
    en
      ? "Your video, ready for your next post | Hooksage"
      : "Tu video, listo para tu próxima publicación | Hooksage"
  }
>
  <StoryMotion />
  <Hero />
  <ScrollWorkflow />
  <section class="story-proof section">
    <div class="container">
      <VideoSamples />
    </div>
  </section>
  <ProductCapabilities />
  <ToneSelector />
  <Examples />
  <Stats />
  <Pricing />
  <FreeVideoForm />
  <FAQ />
  <FinalCTA />
</Layout>
