---
import { localeFromPath, translator } from "../lib/i18n";
import { productFor } from "../data/product";
import Icon from "./Icon.astro";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const { brand } = productFor(lang);
---

<section class="section product-brand" id="marca" aria-labelledby="brand-title">
  <div class="container">
    <div class="brand-heading">
      <div>
        <p class="overline eyebrow">{brand.eyebrow}</p>
        <h2 class="heading-1" id="brand-title">
          {brand.title}
        </h2>
      </div>
      <div class="brand-intro body muted">
        <p>{brand.intro}</p>
        <p>{brand.ideas}</p>
      </div>
    </div>
    <div class="brand-example" aria-label={brand.exampleLabel}>
      <div class="brand-profile">
        <p class="small muted">{brand.exampleLabel}</p>
        <h3 class="heading-3">{brand.profileLabel}</h3>
        <dl>
          {brand.fields.map((field) => (
            <div>
              <dt>{field.name}</dt>
              <dd>{field.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="brand-proposal">
        <p class="overline">{brand.proposalLabel}</p>
        <dl>
          {brand.proposal.map((item) => (
            <div>
              <dt>{item.name}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
    <div class="brand-footer">
      <p class="small muted">{brand.note}</p>
      <a
        class="text-link small"
        href="#empezar"
        data-waitlist-cta
        data-cta-location="brand"
      >
        {t("Probar con mi video")}
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </div>
</section>
<style>
  .product-brand {
    border-top: 1px solid var(--border);
  }
  .brand-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-8);
    align-items: start;
  }
  .brand-heading h2 {
    max-width: 460px;
    margin-top: var(--space-3);
  }
  .brand-intro p {
    margin: 0 0 var(--space-4);
  }
  .brand-example {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    border-block: 1px solid var(--border);
  }
  .brand-profile,
  .brand-proposal {
    padding-block: var(--space-8);
  }
  .brand-profile {
    padding-right: var(--space-12);
  }
  .brand-proposal {
    padding-left: var(--space-12);
    border-left: 1px solid var(--border);
    background: var(--surface-sunken);
    padding-right: var(--space-8);
  }
  .brand-profile > p {
    margin: 0 0 var(--space-3);
  }
  .brand-profile h3 {
    margin: 0 0 var(--space-6);
  }
  dl {
    margin: 0;
  }
  dl > div {
    margin-top: var(--space-4);
  }
  dt {
    font-size: 12px;
    color: var(--ink-muted);
    margin-bottom: var(--space-1);
  }
  dd {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }
  .brand-proposal dt {
    color: var(--primary);
    font-weight: 600;
  }
  .brand-proposal dl > div:first-child dd {
    font-family: var(--font-display);
    font-size: clamp(24px, 2.7vw, 32px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    max-width: 420px;
  }
  .brand-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-6);
  }
  .brand-footer p {
    margin: 0;
    max-width: 640px;
  }
  .brand-footer a {
    flex-shrink: 0;
  }
  @media (max-width: 760px) {
    .brand-heading,
    .brand-example {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .brand-profile {
      padding-right: 0;
    }
    .brand-proposal {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-inline: var(--space-6);
    }
    .brand-footer {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
