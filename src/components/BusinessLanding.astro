---
import {
  localeFromPath,
  translator,
  homePath,
  waitlistHref,
} from "../lib/i18n";
import Layout from "../layouts/Layout.astro";
import VideoCard from "./VideoCard.astro";
import Icon from "./Icon.astro";
import FinalCTA from "./FinalCTA.astro";
import { businesses } from "../data/content";
import { audiences } from "../data/audiences";
import { plans, plansFor } from "../data/plan";
import VideoSamples from "./VideoSamples.astro";
import { getPosts, postPath } from "../lib/blog";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
interface Props {
  business: (typeof businesses)[number];
}
const { business }: Props = Astro.props;
const copy = audiences[business.slug][lang];
// Spanish audience pages link to the guides that answer that audience's next question.
const guideSlugs: Record<string, string[]> = {
  startups: [
    "video-marketing-para-startups",
    "medidas-video-reels-tiktok-shorts",
    "mejores-herramientas-ia-editar-videos-verticales",
  ],
  pymes: [
    "ideas-de-videos-para-pymes",
    "cuanto-cuesta-editar-un-reel",
    "como-editar-videos-verticales-celular",
  ],
  "marca-personal": [
    "marca-personal-con-video",
    "videos-para-coaches-y-consultores",
    "subtitulos-automaticos-videos",
  ],
  "equipos-de-marketing": [
    "calendario-de-contenido-en-video",
    "cuantos-videos-publicar-por-semana",
    "mejores-herramientas-ia-editar-videos-verticales",
  ],
};
const posts = await getPosts();
const guides =
  lang === "es"
    ? guideSlugs[business.slug]
        .map((slug) => posts.find((post) => post.id === slug))
        .filter((post) => post !== undefined)
    : [];
const en = lang === "en";
const plan = plansFor(lang)[plans.findIndex((item) => item.name === copy.plan)];
const faqItems = [
  ...copy.faqs,
  {
    question: en ? "Can I try it for free?" : "¿Puedo probar gratis?",
    answer: en
      ? "Request your first free edit using the form on this website. We arrange the trial by email, with no card or purchase required."
      : "Solicita tu primera edición gratis en el formulario de este sitio. Coordinamos la prueba por email, sin tarjeta ni compra.",
  },
];
const comparison = en
  ? {
      title: "Hooksage, a freelancer or doing it yourself.",
      columns: ["", "Hooksage", "Freelance editor", "Editing it yourself"],
      rows: [
        [
          "Who edits",
          "AI makes the first cut; you review",
          "A person, per piece",
          "You, by hand",
        ],
        [
          "Turnaround",
          "Minutes in the app",
          "Depends on the editor's queue",
          "Depends on your time",
        ],
        [
          "Changes",
          "New version, previous one kept",
          "Back-and-forth by message",
          "You redo it",
        ],
        [
          "Cost",
          "Weekly allowance or one-off packs",
          "Per piece or per hour",
          "Your time",
        ],
      ],
    }
  : {
      title: "Hooksage, un editor freelance o hacerlo tú.",
      columns: ["", "Hooksage", "Editor freelance", "Editarlo tú"],
      rows: [
        [
          "Quién edita",
          "La IA hace el primer corte; tú revisas",
          "Una persona, por pieza",
          "Tú, a mano",
        ],
        [
          "Tiempo",
          "Minutos en la aplicación",
          "Depende de la agenda del editor",
          "Depende de tu tiempo",
        ],
        [
          "Cambios",
          "Nueva versión, se conserva la anterior",
          "Idas y vueltas por mensaje",
          "Lo rehaces tú",
        ],
        [
          "Costo",
          "Cupo semanal o packs de pago único",
          "Por pieza o por hora",
          "Tu tiempo",
        ],
      ],
    };
---

<Layout
  title={copy.metaTitle}
  description={copy.metaDescription}
  faqItems={faqItems}
>
  <section class="section business-hero">
    <div class="container business-hero-grid">
      <div>
        <a href={homePath(lang) + "#ejemplos"} class="text-link small">
          {t("Todos los equipos")}
          <Icon name="arrow" size={18} />
        </a>
        <p class="overline eyebrow">{t("Hispanoamérica")}</p>
        <h1 class="display-l">{business.seo}</h1>
        <p class="heading-2 business-tagline">{business.headline}</p>
        <p class="body-l muted">{business.description}</p>
        <a
          href={waitlistHref(Astro.url.pathname)}
          data-waitlist-cta
          data-cta-location="business"
          class="hs-btn hs-btn--primary"
        >
          {t("Probar con mi video")}
          <Icon name="arrow" />
        </a>
        <p class="small muted">
          {t("Primera edición gratis. Coordinamos por email.")}
        </p>
      </div>
      <VideoCard
        tone={business.tone}
        business={business.singular}
        poster={business.poster}
        headline={business.sample}
        dark
        eager
      />
    </div>
  </section>
  <section class="section business-problem">
    <div class="container">
      <h2 class="heading-1">{copy.problemTitle}</h2>
      <p class="body-l muted">{copy.problem}</p>
    </div>
  </section>
  <section class="section business-ideas">
    <div class="container">
      <p class="overline eyebrow">{t("Empieza con lo que ya tienes")}</p>
      <h2 class="heading-1">{t("Tres ideas de qué grabar.")}</h2>
      <div class="steps-grid">
        {business.ideas.map((idea, i) => (
          <article class="hs-card hs-feature">
            <span class="hs-feature__step">Idea 0{i + 1}</span>
            <h3 class="heading-3">{idea}</h3>
            <p class="body muted">{copy.ideaDetails[i]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section business-samples">
    <div class="container">
      <VideoSamples ctaHref={waitlistHref(Astro.url.pathname)} />
    </div>
  </section>
  <section class="section business-compare">
    <div class="container">
      <h2 class="heading-1">{comparison.title}</h2>
      <div class="business-table-scroll">
        <table class="business-table">
          <thead>
            <tr>
              {comparison.columns.map((column) => (
                <th scope="col">{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {comparison.rows.map(([label, ...cells]) => (
              <tr>
                <th scope="row">{label}</th>
                {cells.map((cell) => (
                  <td>{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  <section class="section business-plan">
    <div class="container">
      <p class="overline eyebrow">
        {en ? "Recommended plan" : "Plan recomendado"}
      </p>
      <h2 class="heading-1">
        {plan.name}: US${plan.monthlyPriceUSD}
        {en ? " a month" : " al mes"}
      </h2>
      <p class="body-l muted">
        {plan.weeklyExports}
        {en ? " videos a week. " : " videos por semana. "}
        {copy.planReason}
      </p>
      <a class="text-link" href={homePath(lang) + "#precio"}>
        {en ? "See all plans and packs" : "Ver todos los planes y packs"}
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
  {guides.length > 0 && (
    <section class="section business-guides">
      <div class="container">
        <p class="overline eyebrow">Guías</p>
        <h2 class="heading-1">Para seguir aprendiendo.</h2>
        <ul class="business-guide-list">
          {guides.map((post) => (
            <li>
              <a class="text-link" href={postPath(post)}>
                {post.data.title}
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <section class="section">
    <div class="container faq-grid">
      <h2 class="heading-1">
        {lang === "en" ? "Questions about " : "Preguntas sobre "}
        {business.seo.toLowerCase()}.
      </h2>
      <div class="faq-list">
        {faqItems.map((faq) => (
          <details>
            <summary>
              <span>{faq.question}</span>
              <Icon name="chevron" size={20} />
            </summary>
            <p class="body muted">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <FinalCTA />
</Layout>
