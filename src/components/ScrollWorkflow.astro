---
import { localeFromPath } from "../lib/i18n";
import { applicationUrl } from "../lib/config";
import Icon from "./Icon.astro";

const en = localeFromPath(Astro.url.pathname) === "en";
const text = (es: string, english: string) => (en ? english : es);
const waveform = [
  24, 46, 32, 65, 84, 49, 72, 42, 93, 61, 38, 78, 100, 59, 34, 71, 48, 86, 58,
  31, 64, 43, 77, 50, 29, 56, 37, 21,
];
const steps = [
  {
    label: text("Tu material", "Your footage"),
    title: text("Subí lo que ya grabaste.", "Start with what you filmed."),
    description: text(
      "Una idea a cámara, una demo o algo que pasa en tu negocio. Cargá el video en la aplicación y contá qué querés comunicar.",
      "A thought to camera, a demo or something happening at your business. Upload your footage in the app and say what you want to communicate.",
    ),
    note: text(
      "Tu voz. Tu contenido. El punto de partida es tuyo.",
      "Your voice. Your footage. Your starting point.",
    ),
    version: "original",
    duration: text("13,6 s", "13.6 sec"),
    filename: "drivo-original.mp4",
  },
  {
    label: text("Primer corte", "First edit"),
    title: text("Recibí el primer corte.", "Get the first edit."),
    description: text(
      "Hooksage prepara una edición vertical con cortes, encuadre y subtítulos. El mismo mensaje, con otra forma de contarlo.",
      "Hooksage prepares a vertical edit with cuts, framing and captions. The same message, with a new way to tell it.",
    ),
    note: text(
      "En este ejemplo: de 13,6 a 11,1 segundos.",
      "In this example: from 13.6 to 11.1 seconds.",
    ),
    version: "edited",
    duration: text("11,1 s", "11.1 sec"),
    filename: "drivo-edited.mp4",
  },
  {
    label: text("Tus ajustes", "Your refinements"),
    title: text("Que quede a tu manera.", "Make it yours."),
    description: text(
      "Mirá el resultado, revisá los textos y pedí cambios desde la aplicación. Cada ajuste parte del corte anterior.",
      "Watch the result, check the text and request changes in the app. Each refinement starts from the previous edit.",
    ),
    note: text(
      "Vos decidís cuándo está listo.",
      "You decide when it is ready.",
    ),
    version: "edited",
    duration: text("11,1 s", "11.1 sec"),
    filename: "drivo-edited.mp4",
  },
  {
    label: text("Listo para compartir", "Ready to share"),
    title: text(
      "Descargalo. Subilo a tus redes.",
      "Download it. Post it to your channels.",
    ),
    description: text(
      "Descargá el MP4 vertical y publicalo en Reels, TikTok o Shorts. La última revisión y el momento de compartirlo son tuyos.",
      "Download your vertical MP4 and post it to Reels, TikTok or Shorts. The final review and when to share it are up to you.",
    ),
    note: text(
      "MP4 vertical · 720 × 1280 · 30 fps",
      "Vertical MP4 · 720 × 1280 · 30 fps",
    ),
    version: "edited",
    duration: text("11,1 s", "11.1 sec"),
    filename: "drivo-edited.mp4",
  },
];
---

<section
  class="scroll-workflow section"
  id="como-funciona"
  aria-labelledby="scroll-workflow-title"
  data-scroll-workflow
>
  <div class="container">
    <div class="scroll-heading">
      <p class="overline scroll-eyebrow">
        {text("De la grabación a la publicación", "From recording to posting")}
      </p>
      <h2 id="scroll-workflow-title">
        {text("Mirá cómo cambia tu video.", "See your video take shape.")}
      </h2>
      <p>
        {text(
          "Seguí una misma pieza, desde el original hasta el archivo que compartís.",
          "Follow one video, from the original footage to the file you share.",
        )}
      </p>
    </div>

    <nav
      class="scroll-chapter-nav"
      data-story-nav
      aria-label={text("Pasos de la edición", "Editing steps")}
      hidden
    >
      {steps.map((step, index) => (
        <button
          type="button"
          data-story-jump={index}
          aria-controls={`workflow-step-${index + 1}`}
          aria-current={index === 0 ? "step" : undefined}
        >
          <span class="scroll-nav-number">0{index + 1}</span>
          <span>{step.label}</span>
        </button>
      ))}
    </nav>

    <div class="scroll-story-track" data-story-track>
      <div class="scroll-chapters">
        {steps.map((step, index) => (
          <article
            class="scroll-chapter"
            id={`workflow-step-${index + 1}`}
            data-story-step={index}
            aria-labelledby={`workflow-heading-${index + 1}`}
          >
            <div class="scroll-chapter-copy">
              <p class="scroll-step-label">
                <span>0{index + 1}</span>
                {step.label}
              </p>
              <h3 id={`workflow-heading-${index + 1}`}>{step.title}</h3>
              <p
                class="scroll-step-description"
                id={`workflow-description-${index + 1}`}
              >
                {step.description}
              </p>
              <p class="scroll-step-note">
                <Icon name="check" size={17} />
                {step.note}
              </p>
            </div>

            <div
              class:list={["scroll-editor", `scroll-editor--${index + 1}`]}
              data-story-scene={index}
              tabindex="-1"
              role="group"
              aria-describedby={`workflow-description-${index + 1}`}
              aria-label={`${text("Recorrido de ejemplo", "Example walkthrough")} · ${step.label}`}
            >
              <div class="scroll-editor-topbar">
                <div class="scroll-editor-brand">
                  <span class="scroll-editor-mark" aria-hidden="true">
                    h.
                  </span>
                  <strong>Hooksage</strong>
                  <span class="scroll-editor-divider" aria-hidden="true"></span>
                  <span>Drivo</span>
                </div>
                <span class="scroll-editor-step">0{index + 1} / 04</span>
              </div>
              <div class="scroll-editor-demo-label">
                <span class="scroll-demo-dot" aria-hidden="true"></span>
                {text(
                  "Recorrido de ejemplo · video real",
                  "Example walkthrough · real video",
                )}
                <span class="scroll-build-cue">
                  <span>
                    {text(
                      "Seguí bajando para armar la edición",
                      "Scroll to put the edit together",
                    )}
                  </span>
                  <i aria-hidden="true"></i>
                </span>
              </div>

              <div class="scroll-editor-body">
                <div class="scroll-editor-preview">
                  <div class="scroll-preview-heading">
                    <span>
                      {index === 0
                        ? text("Material original", "Original footage")
                        : text("Corte editado", "Edited cut")}
                    </span>
                    <span>{step.duration}</span>
                  </div>
                  <div class="scroll-preview-media">
                    <video
                      class="scroll-video"
                      controls
                      playsinline
                      preload="none"
                      poster={`/videos/drivo-${step.version}-poster.webp`}
                      width="720"
                      height="1280"
                      aria-label={text(
                        `Pitch de Drivo · ${index === 0 ? "material original" : "versión editada"}`,
                        `Drivo pitch · ${index === 0 ? "original footage" : "edited version"}`,
                      )}
                    >
                      <source
                        src={`/videos/drivo-${step.version}.mp4`}
                        type="video/mp4"
                      />
                      {index !== 0 && (
                        <track
                          kind="subtitles"
                          srclang="en"
                          label="English"
                          src="/videos/drivo-edited.en.vtt"
                        />
                      )}
                      <a href={`/videos/drivo-${step.version}.mp4`}>
                        {text("Abrir video", "Open video")}
                      </a>
                    </video>
                    <div class="scroll-preview-fragments" aria-hidden="true">
                      {[1, 2, 3].map((slice) => (
                        <div
                          class={`scroll-video-fragment scroll-video-fragment--${slice}`}
                          style={`background-image: url(/videos/drivo-${step.version}-poster.webp);`}
                        ></div>
                      ))}
                    </div>
                    {index === 1 && (
                      <div class="scroll-before-layer" aria-hidden="true">
                        <span class="scroll-edit-sweep"></span>
                      </div>
                    )}
                  </div>
                  <p class="scroll-preview-caption">
                    {text(
                      "Poné play para ver y escuchar.",
                      "Press play to watch and listen.",
                    )}
                  </p>
                </div>

                <div class="scroll-editor-sidebar">
                  {index === 0 && (
                    <>
                      <p class="scroll-panel-eyebrow">
                        {text("El punto de partida", "The starting point")}
                      </p>
                      <h4>
                        {text("Un video. Una idea.", "One video. One idea.")}
                      </h4>
                      <div class="scroll-file-card">
                        <span class="scroll-file-icon">
                          <Icon name="play" size={19} />
                        </span>
                        <div>
                          <strong>{step.filename}</strong>
                          <span>MP4 · {step.duration}</span>
                        </div>
                        <Icon name="check" size={16} />
                      </div>
                      <div class="scroll-intent-card">
                        <span>
                          {text("Qué querés contar", "What you want to say")}
                        </span>
                        <p>
                          {text(
                            "Presentar Drivo y mostrar cómo funciona.",
                            "Introduce Drivo and show how it works.",
                          )}
                        </p>
                      </div>
                      <p class="scroll-panel-footnote">
                        {text(
                          "Este recorrido usa un archivo de ejemplo. Subís el tuyo en la aplicación.",
                          "This walkthrough uses a sample file. Upload your own in the app.",
                        )}
                      </p>
                    </>
                  )}
                  {index === 1 && (
                    <>
                      <p class="scroll-panel-eyebrow">
                        {text("La primera versión", "The first version")}
                      </p>
                      <h4>
                        {text(
                          "El mensaje toma forma.",
                          "The message takes shape.",
                        )}
                      </h4>
                      <ul class="scroll-edit-list">
                        <li>
                          <span class="scroll-edit-icon">Aa</span>
                          <span>
                            <strong>{text("Subtítulos", "Captions")}</strong>
                            <small>
                              {text(
                                "Texto que acompaña la voz",
                                "Text that follows the voice",
                              )}
                            </small>
                          </span>
                          <Icon name="check" size={16} />
                        </li>
                        <li>
                          <span class="scroll-edit-icon">
                            <Icon name="phone" size={18} />
                          </span>
                          <span>
                            <strong>
                              {text("Encuadre vertical", "Vertical framing")}
                            </strong>
                            <small>9:16</small>
                          </span>
                          <Icon name="check" size={16} />
                        </li>
                        <li>
                          <span class="scroll-edit-icon">
                            <Icon name="clock" size={18} />
                          </span>
                          <span>
                            <strong>
                              {text("Un corte más corto", "A shorter cut")}
                            </strong>
                            <small>
                              {text("13,6 s → 11,1 s", "13.6 sec → 11.1 sec")}
                            </small>
                          </span>
                          <Icon name="check" size={16} />
                        </li>
                      </ul>
                      <p class="scroll-panel-footnote">
                        {text(
                          "Compará este resultado con el original del primer paso.",
                          "Compare this result with the original in step one.",
                        )}
                      </p>
                    </>
                  )}
                  {index === 2 && (
                    <>
                      <p class="scroll-panel-eyebrow">
                        {text("Revisión de la edición", "Review the edit")}
                      </p>
                      <h4>
                        {text(
                          "La última palabra es tuya.",
                          "You have the final say.",
                        )}
                      </h4>
                      <div class="scroll-revision-card">
                        <span class="scroll-revision-avatar" aria-hidden="true">
                          {text("Vos", "You")}
                        </span>
                        <div>
                          <span class="scroll-example-label">
                            {text("Pedido de ejemplo", "Example request")}
                          </span>
                          <p>
                            “
                            {text(
                              "Mové el título más abajo.",
                              "Move the title lower.",
                            )}
                            ”
                          </p>
                        </div>
                      </div>
                      <div class="scroll-revision-detail">
                        <span class="scroll-edit-icon">
                          <Icon name="sparkles" size={18} />
                        </span>
                        <p>
                          {text(
                            "Indicá qué querés ajustar y solicitá una nueva versión desde la aplicación.",
                            "Describe what you want to refine and request a new version in the app.",
                          )}
                        </p>
                      </div>
                      <p class="scroll-panel-footnote">
                        {text(
                          "La vista previa muestra el corte existente; este pedido ilustra la revisión.",
                          "The preview shows the existing edit; this request illustrates the review step.",
                        )}
                      </p>
                    </>
                  )}
                  {index === 3 && (
                    <>
                      <p class="scroll-panel-eyebrow">
                        {text("Tu archivo final", "Your finished file")}
                      </p>
                      <h4>
                        {text(
                          "Del editor a tus redes.",
                          "From the editor to your channels.",
                        )}
                      </h4>
                      <div class="scroll-export-card">
                        <span class="scroll-export-icon">
                          <Icon name="check" size={23} />
                        </span>
                        <strong>{step.filename}</strong>
                        <span>MP4 · 720 × 1280 · 30 fps</span>
                      </div>
                      <a
                        class="scroll-download"
                        href="/videos/drivo-edited.mp4"
                        download="hooksage-drivo-ejemplo.mp4"
                      >
                        {" "}
                        <Icon name="upload" size={17} />
                        <span>
                          {text("Descargar ejemplo", "Download sample")}
                        </span>
                      </a>
                      <div class="scroll-destinations">
                        <span>Reels</span>
                        <span>TikTok</span>
                        <span>Shorts</span>
                      </div>
                      <p class="scroll-panel-footnote">
                        {text(
                          "Descargás el archivo. Elegís dónde y cuándo publicarlo.",
                          "Download the file. Choose where and when to post it.",
                        )}
                      </p>
                      <a
                        class="hs-btn hs-btn--primary scroll-primary-cta"
                        href={applicationUrl}
                        data-cta-location="scroll-workflow"
                        data-application-cta
                      >
                        {text("Probar con mi video", "Try it with my video")}
                        <Icon name="arrow" size={16} />
                      </a>
                    </>
                  )}
                </div>
              </div>

              <div class="scroll-editor-bottom">
                <span class="scroll-timeline-label">
                  {index === 0
                    ? text("Original", "Original")
                    : text("Edición", "Edit")}
                </span>
                <div
                  class:list={[
                    "scroll-mini-timeline",
                    { "scroll-mini-timeline--original": index === 0 },
                  ]}
                  aria-hidden="true"
                >
                  <span></span>
                  <span></span>
                  <span></span>
                  <div class="scroll-timeline-wave">
                    {waveform.map((height, bar) => (
                      <b
                        style={`--bar-height: ${height}%; --bar-delay: ${bar * 18}ms;`}
                      ></b>
                    ))}
                  </div>
                  <i></i>
                </div>
                <span>{step.duration}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div
        class="scroll-sticky-stage"
        data-story-stage
        aria-label={text("Vista de la edición", "Editing preview")}
      ></div>
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-scroll-workflow]")
    .forEach((root) => {
      const track = root.querySelector<HTMLElement>("[data-story-track]");
      const stage = root.querySelector<HTMLElement>("[data-story-stage]");
      const nav = root.querySelector<HTMLElement>("[data-story-nav]");
      const chapters = [
        ...root.querySelectorAll<HTMLElement>("[data-story-step]"),
      ];
      const scenes = [
        ...root.querySelectorAll<HTMLElement>("[data-story-scene]"),
      ];
      const copies = chapters.map((chapter) =>
        chapter.querySelector<HTMLElement>(".scroll-chapter-copy")!,
      );
      const buttons = [
        ...root.querySelectorAll<HTMLButtonElement>("[data-story-jump]"),
      ];
      if (
        !track ||
        !stage ||
        !nav ||
        chapters.length !== 4 ||
        scenes.length !== 4
      )
        return;

      const desktop = window.matchMedia(
        "(min-width: 700px) and (min-height: 650px)",
      );
      const compact = window.matchMedia("(max-width: 999px)");
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let enhanced = false;
      let compactMode = false;
      let current = 0;
      let scheduled = false;
      let keyboardInteraction = false;
      const clamp = (value: number) => Math.min(1, Math.max(0, value));
      const phases = [
        ["shell", 0, 0.45],
        ["slice-1", 0.2, 0.5],
        ["slice-2", 0.34, 0.67],
        ["slice-3", 0.46, 0.8],
        ["video", 0.78, 0.92],
        ["edit", 0.3, 0.85],
        ["panel-1", 0.36, 0.68],
        ["panel-2", 0.45, 0.78],
        ["panel-3", 0.55, 0.86],
        ["panel-4", 0.65, 0.94],
        ["wave", 0.5, 0.92],
        ["final", 0.72, 1],
      ] as const;
      const lastBuild = scenes.map(() => -1);
      const renderBuild = (index: number, value: number) => {
        if (!enhanced) return;
        const progress = clamp(value);
        if (Math.abs(lastBuild[index] - progress) < 0.001) return;
        lastBuild[index] = progress;
        const scene = scenes[index];
        scene.style.setProperty("--build-progress", progress.toFixed(4));
        phases.forEach(([name, start, end]) => {
          const part = clamp((progress - start) / (end - start));
          // Keep the assembled video through the first edit, review and export.
          // Only the initial upload uses separate pieces; the first edit is a
          // continuous original-to-result reveal inside the same video frame.
          const carriedLayer =
            (index > 0 && name === "shell") ||
            (index > 0 && (name === "video" || name.startsWith("slice-")));
          const eased = carriedLayer ? 1 : part * part * (3 - 2 * part);
          scene.style.setProperty(`--build-${name}`, eased.toFixed(4));
        });
        scene.dataset.buildProgress = progress.toFixed(4);
      };
      const pauseAll = () =>
        scenes.forEach((scene) =>
          scene.querySelectorAll("video").forEach((video) => video.pause()),
        );
      const select = (index: number) => {
        const followSceneFocus =
          enhanced &&
          index !== current &&
          document.activeElement === scenes[current];
        if (index !== current) pauseAll();
        current = index;
        chapters.forEach((chapter, i) =>
          chapter.classList.toggle("is-current", i === index),
        );
        buttons.forEach((button, i) => {
          if (i === index) button.setAttribute("aria-current", "step");
          else button.removeAttribute("aria-current");
        });
        scenes.forEach((scene, i) => {
          scene.hidden = enhanced && i !== index;
        });
        copies.forEach((copy, i) => {
          copy.hidden = compactMode && i !== index;
        });
        stage.dataset.activeStep = String(index + 1);
        // A chapter jump focuses its scene wrapper. Keep that focus visible as
        // scrolling advances, without pinning the walkthrough to that chapter.
        if (followSceneFocus) scenes[index].focus({ preventScroll: true });
      };
      const update = () => {
        scheduled = false;
        const bounds = track.getBoundingClientRect();
        if (enhanced && (bounds.bottom < 0 || bounds.top > innerHeight)) return;
        const anchor = window.innerHeight * 0.5;
        let nearest = 0;
        let distance = Infinity;
        // Read the chapter positions together, before changing any layer styles.
        const rects = chapters.map((chapter) =>
          chapter.getBoundingClientRect(),
        );
        rects.forEach((rect, index) => {
          const value = Math.abs(rect.top + rect.height * 0.5 - anchor);
          if (value < distance) {
            distance = value;
            nearest = index;
          }
        });
        if (enhanced && nearest !== current) {
          const active = document.activeElement;
          const scene = scenes[current];
          if (
            active instanceof HTMLElement &&
            active !== scene &&
            scene.contains(active)
          ) {
            // Keep keyboard-operated controls available. A wheel, touch gesture
            // or pointer interaction signals that the person is moving on.
            if (keyboardInteraction) {
              renderBuild(current, 1);
              return;
            }
            active.blur();
          }
        }
        select(nearest);
        if (enhanced) {
          const scene = scenes[nearest];
          const active = document.activeElement;
          const player = scene.querySelector("video");
          const usingControls = active !== scene && scene.contains(active);
          const rect = rects[nearest];
          // A chapter is fully assembled when its center reaches the viewport
          // center. The exact same scroll position produces the same layers in
          // either direction; no animation clock or video scrubbing is involved.
          const progress =
            (innerHeight * 0.72 - rect.top) /
            (rect.height * 0.5 + innerHeight * 0.22);
          renderBuild(
            nearest,
            usingControls || (player && !player.paused) ? 1 : progress,
          );
        }
      };
      const schedule = () => {
        if (scheduled) return;
        scheduled = true;
        requestAnimationFrame(update);
      };
      const configure = () => {
        const next = desktop.matches && !reducedMotion.matches;
        const nextCompact = next && compact.matches;
        if (next === enhanced && nextCompact === compactMode) {
          schedule();
          return;
        }
        pauseAll();
        enhanced = next;
        compactMode = nextCompact;
        scenes.forEach((scene, index) => {
          scene.hidden = false;
          const copy = copies[index];
          copy.hidden = false;
          if (compactMode) {
            stage.append(copy, scene);
          } else {
            chapters[index].prepend(copy);
            (enhanced ? stage : chapters[index]).appendChild(scene);
          }
        });
        track.toggleAttribute("data-enhanced", enhanced);
        track.toggleAttribute("data-scrub", enhanced);
        track.toggleAttribute("data-compact", compactMode);
        lastBuild.fill(-1);
        scenes.forEach((scene) => {
          delete scene.dataset.buildProgress;
          scene.style.removeProperty("--build-progress");
          phases.forEach(([name]) =>
            scene.style.removeProperty(`--build-${name}`),
          );
        });
        select(current);
        renderBuild(current, 0);
        schedule();
      };

      nav.hidden = false;
      buttons.forEach((button, index) =>
        button.addEventListener("click", () => {
          select(index);
          chapters[index].scrollIntoView({
            behavior: "instant",
            block: "center",
          });
          renderBuild(index, 1);
          scenes[index].focus({ preventScroll: true });
        }),
      );
      stage.addEventListener("focusout", () => requestAnimationFrame(schedule));
      scenes.forEach((scene, index) => {
        scene.addEventListener("focusin", (event) => {
          if (event.target !== scene) renderBuild(index, 1);
        });
      });
      // The walkthrough and the comparisons share the page: keep one audio
      // source at a time when someone moves from one example to another.
      document.addEventListener(
        "play",
        (event) => {
          if (!(event.target instanceof HTMLVideoElement)) return;
          const player = event.target;
          document
            .querySelectorAll<HTMLVideoElement>("video")
            .forEach((other) => {
              if (other !== player && !other.paused) other.pause();
            });
        },
        true,
      );
      const observer = new IntersectionObserver(schedule, {
        rootMargin: "-15% 0px -15% 0px",
        threshold: [0, 0.25, 0.5, 0.75, 1],
      });
      chapters.forEach((chapter) => observer.observe(chapter));
      window.addEventListener("scroll", schedule, { passive: true });
      window.addEventListener("resize", schedule, { passive: true });
      window.addEventListener("keydown", (event) => {
        if (!["Shift", "Control", "Alt", "Meta"].includes(event.key))
          keyboardInteraction = true;
      });
      window.addEventListener(
        "pointerdown",
        () => {
          keyboardInteraction = false;
        },
        { passive: true },
      );
      const pointerScroll = () => {
        keyboardInteraction = false;
        schedule();
      };
      window.addEventListener("wheel", pointerScroll, { passive: true });
      window.addEventListener("touchmove", pointerScroll, { passive: true });
      desktop.addEventListener("change", configure);
      compact.addEventListener("change", configure);
      reducedMotion.addEventListener("change", configure);
      configure();
    });
</script>

<style>
  .scroll-workflow {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background:
      radial-gradient(
        ellipse at 92% 19%,
        rgba(66, 111, 81, 0.075),
