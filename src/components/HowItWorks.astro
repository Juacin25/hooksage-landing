---
import { localeFromPath, translator } from "../lib/i18n";
import "../styles/workflow.css";
import Icon from "./Icon.astro";
import { productFor } from "../data/product";
import { referenceMedia } from "../data/media";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const workspace = referenceMedia["team-workspace"];
const { workflow } = productFor(lang);
const steps = workflow.steps;
---

<section
  class="section workflow-section"
  id="como-funciona"
  aria-labelledby="how-title"
  data-theme="dark"
>
  <div class="container">
    <div class="workflow-heading">
      <div>
        <p class="overline eyebrow">{workflow.eyebrow}</p>
        <h2 id="how-title">{workflow.title}</h2>
      </div>
      <p class="body muted">{workflow.intro}</p>
    </div>
    <div class="workflow-body">
      <figure class="workflow-photo">
        <picture>
          <source
            type="image/avif"
            srcset={`/media/team-workspace-360.avif 360w, /media/team-workspace.avif ${workspace.width}w`}
            sizes="(max-width: 800px) calc(100vw - 32px), 520px"
          />
          <img
            src="/media/team-workspace.webp"
            srcset={`/media/team-workspace-360.webp 360w, /media/team-workspace.webp ${workspace.width}w`}
            sizes="(max-width: 800px) calc(100vw - 32px), 520px"
            width={workspace.width}
            height={workspace.height}
            alt={t(
              "Un equipo de trabajo compartiendo ideas y preparando contenido.",
            )}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption>
          <span>{workflow.caption}</span>
          <span>{t("Foto de referencia")}</span>
        </figcaption>
      </figure>
      <div class="workflow-guide">
        <ol class="workflow-steps">
          {steps.map((step, index) => (
            <li>
              <span class="workflow-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="workflow-action">
      <a
        class="hs-btn hs-btn--primary"
        href="#empezar"
        data-waitlist-cta
        data-cta-location="workflow"
      >
        {t("Quiero probar Hooksage")} <Icon name="arrow" />
      </a>
      <p>{t("Te avisamos cuando puedas probarlo.")}</p>
    </div>
  </div>
</section>
