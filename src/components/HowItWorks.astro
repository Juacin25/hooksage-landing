---
import "../styles/workflow.css";
import Icon from "./Icon.astro";
import { basePlan } from "../data/plan";
import { referenceMedia } from "../data/media";
const workspace = referenceMedia["team-workspace"];
const steps = [
  {
    title: "Pasá el material como lo grabaste.",
    text: "Una explicación a cámara, una demo o clips de tu equipo. Partí de tus videos sin cortar ni preparar una línea de tiempo.",
  },
  {
    title: "Definí qué querés contar.",
    text: "Indicá el mensaje y el estilo. Hooksage se ocupará de los cortes, los zooms y los subtítulos, con foco en que la pieza se entienda.",
  },
  {
    title: "Revisá, exportá y publicá.",
    text: `Recibí tu video vertical de ${basePlan.videoSeconds} segundos, listo para TikTok, Reels y Shorts. El plan ${basePlan.name} incluye ${basePlan.weeklyExports} videos exportados por semana.`,
  },
];
---

<section
  class="section workflow-section"
  id="como-funciona"
  aria-labelledby="how-title"
  data-theme="dark"
>
  <div class="container">
    <div class="workflow-heading">
      <div>
        <p class="overline eyebrow">Cómo funcionará</p>
        <h2 id="how-title">
          De lo que grabás
          <br />a lo que publicás.
        </h2>
      </div>
      <p class="body muted">
        Un flujo para founders y equipos chicos: del material en crudo a una
        pieza corta para tus canales.
      </p>
    </div>
    <div class="workflow-body">
      <figure class="workflow-photo">
        <picture>
          <source
            type="image/avif"
            srcset={`/media/team-workspace-360.avif 360w, /media/team-workspace.avif ${workspace.width}w`}
            sizes="(max-width: 800px) calc(100vw - 32px), 520px"
          />
          <img
            src="/media/team-workspace.webp"
            srcset={`/media/team-workspace-360.webp 360w, /media/team-workspace.webp ${workspace.width}w`}
            sizes="(max-width: 800px) calc(100vw - 32px), 520px"
            width={workspace.width}
            height={workspace.height}
            alt="Un equipo de trabajo compartiendo ideas y preparando contenido."
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption>
          <span>
            Tu equipo pone las ideas. La herramienta resuelve la edición.
          </span>
          <span>Foto de referencia</span>
        </figcaption>
      </figure>
      <div class="workflow-guide">
        <ol class="workflow-steps">
          {steps.map((step, index) => (
            <li>
              <span class="workflow-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="workflow-action">
      <a
        class="hs-btn hs-btn--primary"
        href="#empezar"
        data-waitlist-cta
        data-cta-location="workflow"
      >
        Quiero probar Hooksage <Icon name="arrow" />
      </a>
      <p>Te avisamos cuando puedas probarlo.</p>
    </div>
  </div>
</section>
