---
import { localeFromPath, translator } from "../lib/i18n";
import "../styles/workflow.css";
import Icon from "./Icon.astro";
import { basePlan } from "../data/plan";
import { referenceMedia } from "../data/media";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const workspace = referenceMedia["team-workspace"];
const steps = [
  {
    title: t("Pasá el material como lo grabaste."),
    text: t(
      "Una explicación a cámara, una demo o clips de tu equipo. Partí de tus videos sin cortar ni preparar una línea de tiempo.",
    ),
  },
  {
    title: t("Definí qué querés contar."),
    text: t(
      "Indicá el mensaje y el estilo. Hooksage se ocupará de los cortes, los zooms y los subtítulos, con foco en que la pieza se entienda.",
    ),
  },
  {
    title: t("Revisá, exportá y publicá."),
    text:
      lang === "en"
        ? "Get your " +
          basePlan.videoSeconds +
          "-second vertical video, ready for TikTok, Reels and Shorts. Founder includes " +
          basePlan.weeklyExports +
          " video exports per week."
        : `Recibí tu video vertical de ${basePlan.videoSeconds} segundos, listo para TikTok, Reels y Shorts. El plan ${basePlan.name} incluye ${basePlan.weeklyExports} videos exportados por semana.`,
  },
];
---

<section
  class="section workflow-section"
  id="como-funciona"
  aria-labelledby="how-title"
  data-theme="dark"
>
  <div class="container">
    <div class="workflow-heading">
      <div>
        <p class="overline eyebrow">{t("Cómo funcionará")}</p>
        <h2 id="how-title">
          {t("De lo que grabás")}
          <br />
          {t("a lo que publicás.")}
        </h2>
      </div>
      <p class="body muted">
        {t(
          "Un flujo para founders y equipos chicos: del material en crudo a una pieza corta para tus canales.",
        )}
      </p>
    </div>
    <div class="workflow-body">
      <figure class="workflow-photo">
        <picture>
          <source
            type="image/avif"
            srcset={`/media/team-workspace-360.avif 360w, /media/team-workspace.avif ${workspace.width}w`}
            sizes="(max-width: 800px) calc(100vw - 32px), 520px"
          />
          <img
            src="/media/team-workspace.webp"
            srcset={`/media/team-workspace-360.webp 360w, /media/team-workspace.webp ${workspace.width}w`}
            sizes="(max-width: 800px) calc(100vw - 32px), 520px"
            width={workspace.width}
            height={workspace.height}
            alt={t(
              "Un equipo de trabajo compartiendo ideas y preparando contenido.",
            )}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption>
          <span>
            {t("Tu equipo pone las ideas. La herramienta resuelve la edición.")}
          </span>
          <span>{t("Foto de referencia")}</span>
        </figcaption>
      </figure>
      <div class="workflow-guide">
        <ol class="workflow-steps">
          {steps.map((step, index) => (
            <li>
              <span class="workflow-number" aria-hidden="true">
                0{index + 1}
              </span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="workflow-action">
      <a
        class="hs-btn hs-btn--primary"
        href="#empezar"
        data-waitlist-cta
        data-cta-location="workflow"
      >
        {t("Quiero probar Hooksage")} <Icon name="arrow" />
      </a>
      <p>{t("Te avisamos cuando puedas probarlo.")}</p>
    </div>
  </div>
</section>
