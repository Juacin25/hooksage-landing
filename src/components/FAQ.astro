---
import Icon from "./Icon.astro";
import { faqs } from "../data/content";
---

<section class="section faq-section" id="preguntas" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div>
      <p class="overline eyebrow">Sin vueltas</p>
      <h2 class="heading-1" id="faq-title">
        Lo que querés saber antes de empezar.
      </h2>
      <p class="body muted">
        Sobre el producto, las primeras pruebas y el acceso.
      </p>
    </div>
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>
            <span>{faq.question}</span>
            <Icon name="chevron" size={20} />
          </summary>
          <p class="body muted">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
