---
import Icon from "./Icon.astro";
import { formEndpoint, contactUrl } from "../lib/config";
---

<section class="section form-section" id="empezar" aria-labelledby="form-title">
  <div class="container form-grid">
    <div class="form-intro">
      <span class="hs-badge hs-badge--accent">Primer video gratis</span>
      <h2 class="heading-1" id="form-title">
        El próximo video de tu equipo
        <br />
        <span>puede salir de acá.</span>
      </h2>
      <p class="body-l muted">
        Contanos qué estás construyendo. Te avisamos por email cuando puedas
        probar Hooksage.
      </p>
      <ul class="form-benefits body">
        <li>
          <Icon name="check" />
          Sin tarjeta ni compromiso
        </li>
        <li>
          <Icon name="check" />
          Con el material que ya tenés
        </li>
        <li>
          <Icon name="check" />
          Listo para TikTok, Reels y Shorts
        </li>
      </ul>
      <div class="form-signoff">
        <img
          src="/logos/hooksage-mark.svg"
          alt=""
          width="40"
          height="40"
          loading="lazy"
        />
        <p class="small muted">
          Vos ponés el contenido.
          <br />
          <strong>Nosotros resolvemos la edición.</strong>
        </p>
      </div>
    </div>
    <div class="hs-card form-card">
      <form
        id="free-video-form"
        action={formEndpoint}
        method="post"
        data-endpoint={formEndpoint}
      >
        <input type="hidden" name="intent" value="waitlist" />
        <input type="hidden" name="landing_path" value={Astro.url.pathname} />
        <div class="form-trap" aria-hidden="true">
          <label for="website">Sitio web</label>
          <input
            id="website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <h3 class="heading-3">Sé de los primeros en probarlo.</h3>
        <p class="small muted form-subtitle">
          Te avisamos del acceso por email. Los campos con * son obligatorios.
        </p>
        <div class="field">
          <label class="label" for="business-name">
            Empresa o marca <span aria-hidden="true">*</span>
          </label>
          <input
            id="business-name"
            name="businessName"
            type="text"
            autocomplete="organization"
            required
            minlength="2"
            maxlength="100"
            placeholder="¿Cómo se llama tu empresa o marca?"
            aria-describedby="business-name-error"
          />
          <span class="field-error small" id="business-name-error"></span>
        </div>
        <div class="field">
          <label class="label" for="business-type">
            Tipo de equipo <span aria-hidden="true">*</span>
          </label>
          <select
            id="business-type"
            name="businessType"
            required
            aria-describedby="business-type-error"
          >
            <option value="">Elegí una opción</option>
            <option>Startup</option>
            <option>Pyme</option>
            <option>Marca personal</option>
            <option>Equipo de marketing</option>
            <option>Agencia</option>
            <option>Otro</option>
          </select>
          <span class="field-error small" id="business-type-error"></span>
        </div>
        <div class="field">
          <label class="label" for="contact-name">
            Tu nombre <span aria-hidden="true">*</span>
          </label>
          <input
            id="contact-name"
            name="contactName"
            type="text"
            autocomplete="name"
            required
            minlength="2"
            maxlength="100"
            placeholder="¿Cómo te llamás?"
            aria-describedby="contact-name-error"
          />
          <span class="field-error small" id="contact-name-error"></span>
        </div>
        <div class="field">
          <label class="label" for="email">
            Email <span aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="254"
            placeholder="tu@correo.com"
            aria-describedby="email-error"
          />
          <span class="field-error small" id="email-error"></span>
        </div>
        <div class="field">
          <label class="label" for="country">
            País <span aria-hidden="true">*</span>
          </label>
          <select
            id="country"
            name="country"
            required
            aria-describedby="country-error"
          >
            <option value="">Elegí tu país</option>
            <option value="UY">Uruguay</option>
            <option value="AR">Argentina</option>
          </select>
          <span class="field-error small" id="country-error"></span>
        </div>
        <div class="field">
          <label class="label" for="whatsapp">
            WhatsApp <span class="optional">(opcional)</span>
          </label>
          <input
            id="whatsapp"
            name="whatsapp"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="24"
            pattern="\+[0-9\s\(\)\.\-]{8,23}"
            title="Incluí el código de país: +598 para Uruguay o +54 para Argentina."
            placeholder="+598 99 123 456"
            aria-describedby="whatsapp-help whatsapp-error"
          />
          <span class="small muted field-help" id="whatsapp-help">
            Incluí el código de país: +598 para Uruguay o +54 para Argentina.
          </span>
          <span class="field-error small" id="whatsapp-error"></span>
        </div>
        <div class="field">
          <label class="label" for="city">
            Ciudad <span aria-hidden="true">*</span>
          </label>
          <input
            id="city"
            name="city"
            type="text"
            autocomplete="address-level2"
            required
            minlength="2"
            maxlength="100"
            placeholder="Montevideo, Buenos Aires, Rosario…"
            aria-describedby="city-error"
          />
          <span class="field-error small" id="city-error"></span>
        </div>
        <p class="small muted form-consent">
          Usaremos estos datos para coordinar las primeras pruebas y avisarte
          del acceso.
        </p>
        <button class="hs-btn hs-btn--primary" type="submit">
          <span data-submit-label>Quiero estar en la lista</span>
          <Icon name="arrow" />
        </button>
        <p
          class="form-status small"
          id="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
        ></p>
        <noscript>
          <p class="small">
            Podés enviar este formulario sin activar JavaScript.
            <a href={contactUrl}>También podés escribirnos por email.</a>
          </p>
        </noscript>
      </form>
      <div class="form-success" id="form-success" hidden tabindex="-1">
        <div class="success-icon">
          <Icon name="check" size={32} />
        </div>
        <h3 class="heading-2">¡Listo! Ya estás en la lista.</h3>
        <p class="body muted">
          Te avisaremos por email cuando puedas probar Hooksage.
        </p>
        <a
          class="hs-btn hs-btn--primary"
          id="success-contact"
          href={contactUrl}
        >
          Escribirnos por email
        </a>
      </div>
    </div>
  </div>
</section>
<script>
  import { normalizePhone } from "../../server/phone.mjs";
  const form = document.querySelector<HTMLFormElement>("#free-video-form");
  if (
    form &&
    typeof window.fetch === "function" &&
    typeof window.AbortController === "function"
  ) {
    const status = document.getElementById("form-status")!;
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const fields = {
      name: form.querySelector<HTMLInputElement>("#business-name")!,
      type: form.querySelector<HTMLSelectElement>("#business-type")!,
      contact: form.querySelector<HTMLInputElement>("#contact-name")!,
      email: form.querySelector<HTMLInputElement>("#email")!,
      phone: form.querySelector<HTMLInputElement>("#whatsapp")!,
      city: form.querySelector<HTMLInputElement>("#city")!,
      country: form.querySelector<HTMLSelectElement>("#country")!,
    };
    let sending = false;
    form.addEventListener(
      "input",
      () => window.HooksageFunnel?.track("waitlist_form_start"),
      { once: true },
    );
    const selectedBusiness = new URLSearchParams(window.location.search).get(
      "rubro",
    );
    const businessTypes: Record<string, string> = {
      startups: "Startup",
      pymes: "Pyme",
      "marca-personal": "Marca personal",
      "equipos-de-marketing": "Equipo de marketing",
    };
    if (
      selectedBusiness &&
      Object.prototype.hasOwnProperty.call(businessTypes, selectedBusiness) &&
      !fields.type.value
    )
      fields.type.value = businessTypes[selectedBusiness];
    const phoneNumber = () =>
      normalizePhone(fields.phone.value, fields.country.value);
    function validate(field: HTMLInputElement | HTMLSelectElement) {
      let message = "";
      if (field === fields.name && field.value.trim().length < 2)
        message =
          "Escribí el nombre de tu empresa o marca (al menos 2 caracteres).";
      if (field === fields.type && !field.value)
        message = "Elegí el tipo de equipo.";
      if (field === fields.contact && field.value.trim().length < 2)
        message = "Escribí tu nombre.";
      if (
        field === fields.email &&
        (!field.value.trim() ||
          fields.email.validity.typeMismatch ||
          field.value.trim().length > 254)
      )
        message = "Escribí un email válido.";
      if (field === fields.country && !["UY", "AR"].includes(field.value))
        message = "Elegí tu país.";
      if (
        field === fields.phone &&
        fields.phone.value.trim() &&
        phoneNumber() === null
      )
        message = "Revisá el número y el código de tu país (+598 o +54).";
      if (field === fields.city && field.value.trim().length < 2)
        message = "Escribí tu ciudad.";
      if (
        [fields.name, fields.contact, fields.city].includes(
          field as HTMLInputElement,
        ) &&
        field.value.trim().length > 100
      )
        message = "Usá un máximo de 100 caracteres.";
      field.setAttribute("aria-invalid", String(Boolean(message)));
      document.getElementById(`${field.id}-error`)!.textContent = message;
      return !message;
    }
    Object.values(fields).forEach((field) => {
      field.addEventListener("blur", () => validate(field));
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true") validate(field);
      });
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending || form.hidden) return;
      status.textContent = "";
      const invalid = Object.values(fields).filter((field) => !validate(field));
      if (invalid.length) {
        window.HooksageFunnel?.track("waitlist_form_error", {
          error_type: "validation",
        });
        invalid[0].focus();
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        window.HooksageFunnel?.track("waitlist_form_error", {
          error_type: "not_configured",
        });
        status.textContent =
          "El formulario aún no está disponible. Intentá de nuevo más tarde.";
        status.dataset.error = "true";
        status.focus();
        return;
      }
      sending = true;
      button.disabled = true;
      form.setAttribute("aria-busy", "true");
      label.textContent = "Enviando…";
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      try {
        const payload = {
          businessName: fields.name.value.trim(),
          businessType: fields.type.value,
          contactName: fields.contact.value.trim(),
          email: fields.email.value.trim(),
          whatsapp: phoneNumber() || "",
          country: fields.country.value,
          city: fields.city.value.trim(),
          neighborhood: "",
          intent: "waitlist",
          website: form.querySelector<HTMLInputElement>("#website")!.value,
          attribution: window.HooksageFunnel?.getAttribution() || {
            landing_path: window.location.pathname,
          },
        };
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        if (!response.ok) throw new Error("form_request_failed");
        const result = await response.json();
        if (result.ok !== true || typeof result.created !== "boolean")
          throw new Error("form_invalid_confirmation");
        const success = document.getElementById("form-success")!;
        form.hidden = true;
        success.hidden = false;
        success.focus();
        if (result.created) window.HooksageFunnel?.track("generate_lead");
      } catch {
        window.HooksageFunnel?.track("waitlist_form_error", {
          error_type: "request_failed",
        });
        status.textContent =
          "No pudimos enviar tus datos. Revisá tu conexión e intentá de nuevo.";
        status.dataset.error = "true";
        status.focus();
      } finally {
        window.clearTimeout(timeout);
        sending = false;
        button.disabled = false;
        form.removeAttribute("aria-busy");
        label.textContent = "Quiero estar en la lista";
      }
    });
    // Native validation and POST remain available if enhancement cannot start.
    form.noValidate = true;
  }
</script>
