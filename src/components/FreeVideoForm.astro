---
import { localeFromPath, translator } from "../lib/i18n";
import Icon from "./Icon.astro";
import { formEndpoint, contactUrl } from "../lib/config";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const countries =
  lang === "en"
    ? [
        ["US", "Estados Unidos"],
        ["GB", "Reino Unido"],
        ["UY", "Uruguay"],
        ["AR", "Argentina"],
      ]
    : [
        ["UY", "Uruguay"],
        ["AR", "Argentina"],
        ["US", "Estados Unidos"],
        ["GB", "Reino Unido"],
      ];
const messages = Object.fromEntries(
  Object.entries({
    businessName:
      "Escribí el nombre de tu empresa o marca (al menos 2 caracteres).",
    type: "Elegí el tipo de equipo.",
    contact: "Escribí tu nombre.",
    email: "Escribí un email válido.",
    country: "Elegí tu país.",
    phone: "Revisá el número y el código de tu país.",
    city: "Escribí tu ciudad.",
    length: "Usá un máximo de 100 caracteres.",
    notConfigured:
      "El formulario aún no está disponible. Intentá de nuevo más tarde.",
    sending: "Enviando…",
    requestFailed:
      "No pudimos enviar tus datos. Revisá tu conexión e intentá de nuevo.",
    footage: "Usá un enlace HTTPS válido, sin usuario ni contraseña.",
    feedback: "Contanos tu experiencia en un máximo de 1000 caracteres.",
    submit: "Solicitar mi edición gratis",
  }).map(([key, source]) => [key, t(source)]),
);
---

<section class="section form-section" id="empezar" aria-labelledby="form-title">
  <div class="container form-grid">
    <div class="form-intro">
      <span class="hs-badge hs-badge--accent">{t("Primer video gratis")}</span>
      <h2 class="heading-1" id="form-title">
        {t("Probemos con un video tuyo.")}
        <br />
        <span>{t("La primera edición es gratis.")}</span>
      </h2>
      <p class="body-l muted">
        {t(
          "Dejanos un enlace al clip y contanos qué querés mejorar. Una persona del equipo te escribe para coordinar la prueba. Si todavía no tenés el video, podés dejar el enlace para después.",
        )}
      </p>
      <ul class="form-benefits body">
        <li>
          <Icon name="check" />
          {t("Sin tarjeta ni compromiso")}
        </li>
        <li>
          <Icon name="check" />
          {t("Con tus grabaciones o ideas")}
        </li>
        <li>
          <Icon name="check" />
          {t("Listo para TikTok, Reels y Shorts")}
        </li>
      </ul>
      <div class="form-signoff">
        <img
          src="/logos/hooksage-mark.svg"
          alt=""
          width="40"
          height="40"
          loading="lazy"
        />
        <p class="small muted">
          {t("Vos ponés el contenido.")}
          <br />
          <strong>{t("Nosotros resolvemos la edición.")}</strong>
        </p>
      </div>
    </div>
    <div class="hs-card form-card">
      <form
        id="free-video-form"
        action={formEndpoint}
        method="post"
        data-endpoint={formEndpoint}
        data-language={lang}
        data-messages={JSON.stringify(messages)}
      >
        <input type="hidden" name="intent" value="waitlist" />
        <input type="hidden" name="language" value={lang} />
        <input type="hidden" name="landing_path" value={Astro.url.pathname} />
        <div class="form-trap" aria-hidden="true">
          <label for="website">{t("Sitio web")}</label>
          <input
            id="website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <h3 class="heading-3">{t("Solicitá tu primera edición.")}</h3>
        <p class="small muted form-subtitle">
          {t(
            "Coordinamos la prueba por email. El enlace y la pregunta de edición son opcionales; los campos con * son obligatorios.",
          )}
        </p>
        <div class="field">
          <label class="label" for="business-name">
            {t("Empresa o marca")} <span aria-hidden="true">*</span>
          </label>
          <input
            id="business-name"
            name="businessName"
            type="text"
            autocomplete="organization"
            required
            minlength="2"
            maxlength="100"
            placeholder={t("¿Cómo se llama tu empresa o marca?")}
            aria-describedby="business-name-error"
          />
          <span class="field-error small" id="business-name-error"></span>
        </div>
        <div class="field">
          <label class="label" for="business-type">
            {t("Tipo de equipo")} <span aria-hidden="true">*</span>
          </label>
          <select
            id="business-type"
            name="businessType"
            required
            aria-describedby="business-type-error"
          >
            <option value="">{t("Elegí una opción")}</option>
            <option value="Startup">{t("Startup")}</option>
            <option value="Pyme">{t("Pyme")}</option>
            <option value="Marca personal">{t("Marca personal")}</option>
            <option value="Equipo de marketing">
              {t("Equipo de marketing")}
            </option>
            <option value="Agencia">{t("Agencia")}</option>
            <option value="Otro">{t("Otro")}</option>
          </select>
          <span class="field-error small" id="business-type-error"></span>
        </div>
        <div class="field">
          <label class="label" for="contact-name">
            {t("Tu nombre")} <span aria-hidden="true">*</span>
          </label>
          <input
            id="contact-name"
            name="contactName"
            type="text"
            autocomplete="name"
            required
            minlength="2"
            maxlength="100"
            placeholder={t("¿Cómo te llamás?")}
            aria-describedby="contact-name-error"
          />
          <span class="field-error small" id="contact-name-error"></span>
        </div>
        <div class="field">
          <label class="label" for="email">
            {t("Email")} <span aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            inputmode="email"
            required
            maxlength="254"
            placeholder={t("tu@correo.com")}
            aria-describedby="email-error"
          />
          <span class="field-error small" id="email-error"></span>
        </div>
        <div class="field">
          <label class="label" for="country">
            {t("País")} <span aria-hidden="true">*</span>
          </label>
          <select
            id="country"
            name="country"
            required
            aria-describedby="country-error"
          >
            <option value="">{t("Elegí tu país")}</option>
            {countries.map(([value, label]) => (
              <option value={value}>{t(label)}</option>
            ))}
          </select>
          <span class="field-error small" id="country-error"></span>
        </div>
        <div class="field">
          <label class="label" for="whatsapp">
            {t("WhatsApp")} <span class="optional">{t("(opcional)")}</span>
          </label>
          <input
            id="whatsapp"
            name="whatsapp"
            type="tel"
            autocomplete="tel"
            inputmode="tel"
            maxlength="24"
            pattern="\+[0-9\s\(\)\.\-]{8,23}"
            title={t(
              "Incluí el código de país, por ejemplo +1, +44, +598 o +54.",
            )}
            placeholder={t("+598 99 123 456")}
            aria-describedby="whatsapp-help whatsapp-error"
          />
          <span class="small muted field-help" id="whatsapp-help">
            {t("Incluí el código de país, por ejemplo +1, +44, +598 o +54.")}
          </span>
          <span class="field-error small" id="whatsapp-error"></span>
        </div>
        <div class="field">
          <label class="label" for="city">
            {t("Ciudad")} <span aria-hidden="true">*</span>
          </label>
          <input
            id="city"
            name="city"
            type="text"
            autocomplete="address-level2"
            required
            minlength="2"
            maxlength="100"
            placeholder={t("Montevideo, Buenos Aires, Rosario…")}
            aria-describedby="city-error"
          />
          <span class="field-error small" id="city-error"></span>
        </div>
        <div class="field">
          <label class="label" for="footage-url">
            {t("Enlace a tu video")}{" "}
            <span class="optional">{t("(opcional)")}</span>
          </label>
          <input
            id="footage-url"
            name="footageUrl"
            type="url"
            maxlength="2048"
            pattern="https://.+"
            placeholder="https://drive.google.com/…"
            autocomplete="off"
            aria-describedby="footage-url-help footage-url-error"
          />
          <span class="small muted field-help" id="footage-url-help">
            {t(
              "Drive, Dropbox o similar. Revisá que el enlace permita ver el clip. También podés mandarlo después por email.",
            )}
          </span>
          <span class="field-error small" id="footage-url-error"></span>
        </div>
        <div class="field">
          <label class="label" for="editing-feedback">
            {t("¿Qué tuviste que rehacer en tu último video?")}{" "}
            <span class="optional">{t("(opcional)")}</span>
          </label>
          <textarea
            id="editing-feedback"
            name="editingFeedback"
            rows="3"
            maxlength="1000"
            placeholder={t(
              "Por ejemplo: corregir subtítulos, sacar pausas o volver a hacer los cortes.",
            )}
            aria-describedby="editing-feedback-help editing-feedback-error"
          ></textarea>
          <span class="small muted field-help" id="editing-feedback-help">
            {t("Si probaste un editor con IA, contanos qué no funcionó.")}
          </span>
          <span class="field-error small" id="editing-feedback-error"></span>
        </div>
        <p class="small muted form-consent">
          {t(
            "Usaremos tus datos y el enlace que compartas para coordinar la prueba y avisarte del acceso. Registrarte no abre una cuenta ni activa una suscripción.",
          )}
        </p>
        <button class="hs-btn hs-btn--primary" type="submit">
          <span data-submit-label>{t("Solicitar mi edición gratis")}</span>
          <Icon name="arrow" />
        </button>
        <p
          class="form-status small"
          id="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
        ></p>
        <noscript>
          <p class="small">
            {t("Podés enviar este formulario sin activar JavaScript.")}
            <a href={contactUrl}>{t("También podés escribirnos por email.")}</a>
          </p>
        </noscript>
      </form>
      <div class="form-success" id="form-success" hidden tabindex="-1">
        <div class="success-icon">
          <Icon name="check" size={32} />
        </div>
        <h3 class="heading-2">{t("Recibimos tu solicitud.")}</h3>
        <p class="body muted">
          {t(
            "Te escribimos por email para coordinar la prueba. Si todavía no compartiste el clip, podés responder con el enlace cuando te contactemos.",
          )}
        </p>
        <a
          class="hs-btn hs-btn--primary"
          id="success-contact"
          href={contactUrl}
        >
          {t("Escribirnos por email")}
        </a>
      </div>
    </div>
  </div>
</section>
<script>
  import { normalizePhone } from "../../server/phone.mjs";
  import {
    normalizeFootageUrl,
    normalizeEditingFeedback,
  } from "../../server/trial-fields.mjs";
  const form = document.querySelector<HTMLFormElement>("#free-video-form");
  if (
    form &&
    typeof window.fetch === "function" &&
    typeof window.AbortController === "function"
  ) {
    const messages: Record<string, string> = JSON.parse(
      form.dataset.messages || "{}",
    );
    const status = document.getElementById("form-status")!;
    const button = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    )!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const fields = {
      name: form.querySelector<HTMLInputElement>("#business-name")!,
      type: form.querySelector<HTMLSelectElement>("#business-type")!,
      contact: form.querySelector<HTMLInputElement>("#contact-name")!,
      email: form.querySelector<HTMLInputElement>("#email")!,
      phone: form.querySelector<HTMLInputElement>("#whatsapp")!,
      city: form.querySelector<HTMLInputElement>("#city")!,
      country: form.querySelector<HTMLSelectElement>("#country")!,
      footage: form.querySelector<HTMLInputElement>("#footage-url")!,
      feedback: form.querySelector<HTMLTextAreaElement>("#editing-feedback")!,
    };
    fields.country.addEventListener("change", () => {
      const examples: Record<string, string> = {
        US: "+1 202 555 0123",
        GB: "+44 7700 900123",
        UY: "+598 99 123 456",
        AR: "+54 9 11 1234 5678",
      };
      fields.phone.placeholder =
        examples[fields.country.value] ||
        (form.dataset.language === "en" ? examples.US : examples.UY);
      if (fields.phone.value) validate(fields.phone);
    });
    let sending = false;
    form.addEventListener(
      "input",
      () => window.HooksageFunnel?.track("waitlist_form_start"),
      { once: true },
    );
    const selectedBusiness = new URLSearchParams(window.location.search).get(
      "rubro",
    );
    const businessTypes: Record<string, string> = {
      startups: "Startup",
      pymes: "Pyme",
      "marca-personal": "Marca personal",
      "equipos-de-marketing": "Equipo de marketing",
    };
    if (
      selectedBusiness &&
      Object.prototype.hasOwnProperty.call(businessTypes, selectedBusiness) &&
      !fields.type.value
    )
      fields.type.value = businessTypes[selectedBusiness];
    const phoneNumber = () =>
      normalizePhone(fields.phone.value, fields.country.value);
    function validate(
      field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement,
    ) {
      let message = "";
      if (field === fields.name && field.value.trim().length < 2)
        message = messages.businessName;
      if (field === fields.type && !field.value) message = messages.type;
      if (field === fields.contact && field.value.trim().length < 2)
        message = messages.contact;
      if (
        field === fields.email &&
        (!field.value.trim() ||
          fields.email.validity.typeMismatch ||
          field.value.trim().length > 254)
      )
        message = messages.email;
      if (
        field === fields.country &&
        !["UY", "AR", "US", "GB"].includes(field.value)
      )
        message = messages.country;
      if (
        field === fields.phone &&
        fields.phone.value.trim() &&
        phoneNumber() === null
      )
        message = messages.phone;
      if (field === fields.city && field.value.trim().length < 2)
        message = messages.city;
      if (
        [fields.name, fields.contact, fields.city].includes(
          field as HTMLInputElement,
        ) &&
        field.value.trim().length > 100
      )
        message = messages.length;
      if (field === fields.footage && normalizeFootageUrl(field.value) === null)
        message = messages.footage;
      if (
        field === fields.feedback &&
        normalizeEditingFeedback(field.value) === null
      )
        message = messages.feedback;
      field.setAttribute("aria-invalid", String(Boolean(message)));
      document.getElementById(`${field.id}-error`)!.textContent = message;
      return !message;
    }
    Object.values(fields).forEach((field) => {
      field.addEventListener("blur", () => validate(field));
      field.addEventListener("input", () => {
        if (field.getAttribute("aria-invalid") === "true") validate(field);
      });
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (sending || form.hidden) return;
      status.textContent = "";
      const invalid = Object.values(fields).filter((field) => !validate(field));
      if (invalid.length) {
        window.HooksageFunnel?.track("waitlist_form_error", {
          error_type: "validation",
        });
        invalid[0].focus();
        return;
      }
      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        window.HooksageFunnel?.track("waitlist_form_error", {
          error_type: "not_configured",
        });
        status.textContent = messages.notConfigured;
        status.dataset.error = "true";
        status.focus();
        return;
      }
      sending = true;
      button.disabled = true;
      form.setAttribute("aria-busy", "true");
      label.textContent = messages.sending;
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      try {
        const payload = {
          businessName: fields.name.value.trim(),
          businessType: fields.type.value,
          contactName: fields.contact.value.trim(),
          email: fields.email.value.trim(),
          whatsapp: phoneNumber() || "",
          country: fields.country.value,
          language: form.dataset.language || "es",
          city: fields.city.value.trim(),
          neighborhood: "",
          footageUrl: normalizeFootageUrl(fields.footage.value) || "",
          editingFeedback:
            normalizeEditingFeedback(fields.feedback.value) || "",
          intent: "waitlist",
          website: form.querySelector<HTMLInputElement>("#website")!.value,
          attribution: window.HooksageFunnel?.getAttribution() || {
            landing_path: window.location.pathname,
          },
        };
        const response = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        if (!response.ok) throw new Error("form_request_failed");
        const result = await response.json();
        if (result.ok !== true || typeof result.created !== "boolean")
          throw new Error("form_invalid_confirmation");
        const success = document.getElementById("form-success")!;
        form.hidden = true;
        success.hidden = false;
        success.focus();
        if (result.created) window.HooksageFunnel?.track("generate_lead");
      } catch {
        window.HooksageFunnel?.track("waitlist_form_error", {
          error_type: "request_failed",
        });
        status.textContent = messages.requestFailed;
        status.dataset.error = "true";
        status.focus();
      } finally {
        window.clearTimeout(timeout);
        sending = false;
        button.disabled = false;
        form.removeAttribute("aria-busy");
        label.textContent = messages.submit;
      }
    });
    // Native validation and POST remain available if enhancement cannot start.
    form.noValidate = true;
  }
</script>
