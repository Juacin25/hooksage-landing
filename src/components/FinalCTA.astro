---
import { localeFromPath, translator, waitlistHref } from "../lib/i18n";
import Icon from "./Icon.astro";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const formHref = waitlistHref(Astro.url.pathname);
---

<section class="section final-cta" aria-labelledby="final-title">
  <div class="container">
    <img
      src="/logos/hooksage-mark.svg"
      width="56"
      height="56"
      alt=""
      loading="lazy"
    />
    <h2 class="heading-1" id="final-title">
      {t("El próximo video de tu equipo")} <br />
      {t("empieza con lo que ya grabaste.")}
    </h2>
    <a
      class="hs-btn hs-btn--primary"
      href={formHref}
      data-waitlist-cta
      data-cta-location="finalcta"
    >
      {t("Quiero probar Hooksage")}
      <Icon name="arrow" />
    </a>
    <p class="small muted">
      {t("Te avisamos cuando puedas probar Hooksage. Sin tarjeta.")}
    </p>
  </div>
</section>
