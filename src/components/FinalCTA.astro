---
import Icon from "./Icon.astro";
const formHref = Astro.params.rubro
  ? `/?rubro=${encodeURIComponent(Astro.params.rubro)}#empezar`
  : "/#empezar";
---

<section class="section final-cta" aria-labelledby="final-title">
  <div class="container">
    <img
      src="/logos/hooksage-mark.svg"
      width="56"
      height="56"
      alt=""
      loading="lazy"
    />
    <h2 class="heading-1" id="final-title">
      El próximo video de tu equipo <br />
      empieza con lo que ya grabaste.
    </h2>
    <a
      class="hs-btn hs-btn--primary"
      href={formHref}
      data-waitlist-cta
      data-cta-location="finalcta"
    >
      Quiero probar Hooksage
      <Icon name="arrow" />
    </a>
    <p class="small muted">
      Te avisamos cuando puedas probar Hooksage. Sin tarjeta.
    </p>
  </div>
</section>
