---
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/global.css";
import "../styles/showcase.css";
import "../styles/story-landing.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FunnelTracking from "../components/FunnelTracking.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { contentFor, type faqs } from "../data/content";
import { localeFromPath, translator, alternatePath } from "../lib/i18n";
import { business } from "../data/business";
import { contactEmail } from "../lib/config";
const lang = localeFromPath(Astro.url.pathname);
const analyticsEnabled = import.meta.env.PUBLIC_ENABLE_ANALYTICS !== "false";
const t = translator(lang);
const faqsForLanguage = contentFor(lang).faqs;
const ogImage =
  "https://hooksage.com/" +
  (lang === "en" ? "og-product-en.png" : "og-product.png");
interface Props {
  title?: string;
  description?: string;
  faqItems?: typeof faqs;
  variant?: "default" | "story";
}
const {
  title = lang === "en"
    ? "Turn raw footage into an edited short | Hooksage"
    : "De tu video en crudo a un short editado | Hooksage",
  description = lang === "en"
    ? "Turn your phone footage into a vertical short with cuts, reframing and captions. Send a clip to try your first edit free. For startups and small teams."
    : "Convertí tus grabaciones en un short vertical con cortes, encuadre y subtítulos. Mandanos un clip para probar tu primera edición gratis.",
  faqItems = faqsForLanguage,
  variant = "default",
}: Props = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://hooksage.com/").href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hooksage.com/#organization",
      name: business.brand,
      legalName: business.legalName,
      taxID: business.taxId,
      email: contactEmail,
      address: business.legalAddress,
      url: "https://hooksage.com/",
      logo: "https://hooksage.com/logos/hooksage-lockup.svg",
    },
    {
      "@type": "SoftwareApplication",
      name: "Hooksage",
      url: "https://hooksage.com/",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Web",
      description:
        lang === "en"
          ? "Brand-led content ideas, scripts and short-form video editing, with voiceover, motion, sound and version history."
          : "Ideas de contenido, guiones y edición de videos cortos según tu marca, con voz en off, movimiento, sonido y versiones.",
      inLanguage: lang,
      areaServed: [
        { "@type": "Country", name: "United States" },
        { "@type": "Country", name: "United Kingdom" },
        { "@type": "Country", name: "Uruguay" },
        { "@type": "Country", name: "Argentina" },
      ],
    },
    ...(faqItems.length
      ? [
          {
            "@type": "FAQPage",
            mainEntity: faqItems.map(({ question, answer }) => ({
              "@type": "Question",
              name: question,
              acceptedAnswer: { "@type": "Answer", text: answer },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html
  lang={lang === "en" ? "en" : "es-UY"}
  data-theme={variant === "story" ? "dark" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="color-scheme"
      content={variant === "story" ? "dark" : "light dark"}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="es"
      href={
        new URL(
          alternatePath(Astro.url.pathname, "es"),
          "https://hooksage.com/",
        ).href
      }
    />
    <link
      rel="alternate"
      hreflang="en"
      href={
        new URL(
          alternatePath(Astro.url.pathname, "en"),
          "https://hooksage.com/",
        ).href
      }
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(
          alternatePath(Astro.url.pathname, "es"),
          "https://hooksage.com/",
        ).href
      }
    />
    <link rel="icon" href="/logos/hooksage-app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_UY"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "es_UY" : "en_US"}
    />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Hooksage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        lang === "en"
          ? "Hooksage. More videos. Less time editing. For startups and small teams."
          : "Hooksage. Más videos. Menos horas editando. Startups y pymes de Uruguay y Argentina."
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </head>
  <body class:list={{ "landing--story": variant === "story" }}>
    <a class="skip-link hs-btn hs-btn--primary" href="#contenido">
      {t("Saltar al contenido")}
    </a>
    <Header story={variant === "story"} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CookieConsent enabled={analyticsEnabled} />
    <FunnelTracking />
  </body>
</html>
