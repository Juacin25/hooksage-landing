---
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/global.css";
import "../styles/showcase.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FunnelTracking from "../components/FunnelTracking.astro";
import { contentFor, type faqs } from "../data/content";
import { localeFromPath, translator, alternatePath } from "../lib/i18n";
const lang = localeFromPath(Astro.url.pathname);
const t = translator(lang);
const faqsForLanguage = contentFor(lang).faqs;
const ogImage =
  "https://hooksage.com/" +
  (lang === "en" ? "og-product-en.png" : "og-product.png");
interface Props {
  title?: string;
  description?: string;
  faqItems?: typeof faqs;
}
const {
  title = lang === "en"
    ? "Short-form video editing for startups & teams | Hooksage"
    : "Edición de videos para startups y pymes | Hooksage",
  description = lang === "en"
    ? "Content ideas, scripts and short videos shaped by your brand. Use your footage or a voiceover, with motion and sound. Join the Hooksage waitlist."
    : "Ideas, guiones y edición de videos cortos según tu marca. Grabaciones o voz en off, con texto, movimiento y sonido. Sumate al acceso anticipado.",
  faqItems = faqsForLanguage,
}: Props = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://hooksage.com/").href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hooksage.com/#organization",
      name: "Hooksage",
      url: "https://hooksage.com/",
      logo: "https://hooksage.com/logos/hooksage-lockup.svg",
    },
    {
      "@type": "SoftwareApplication",
      name: "Hooksage",
      url: "https://hooksage.com/",
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Web",
      description:
        lang === "en"
          ? "Brand-led content ideas, scripts and short-form video editing, with voiceover, motion, sound and version history."
          : "Ideas de contenido, guiones y edición de videos cortos según tu marca, con voz en off, movimiento, sonido y versiones.",
      inLanguage: lang,
      areaServed: [
        { "@type": "Country", name: "United States" },
        { "@type": "Country", name: "United Kingdom" },
        { "@type": "Country", name: "Uruguay" },
        { "@type": "Country", name: "Argentina" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: { "@type": "Answer", text: answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang === "en" ? "en" : "es-UY"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="es"
      href={
        new URL(
          alternatePath(Astro.url.pathname, "es"),
          "https://hooksage.com/",
        ).href
      }
    />
    <link
      rel="alternate"
      hreflang="en"
      href={
        new URL(
          alternatePath(Astro.url.pathname, "en"),
          "https://hooksage.com/",
        ).href
      }
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={
        new URL(
          alternatePath(Astro.url.pathname, "es"),
          "https://hooksage.com/",
        ).href
      }
    />
    <link rel="icon" href="/logos/hooksage-app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_UY"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "es_UY" : "en_US"}
    />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Hooksage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        lang === "en"
          ? "Hooksage. More videos. Less time editing. For startups and small teams."
          : "Hooksage. Más videos. Menos horas editando. Startups y pymes de Uruguay y Argentina."
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
    <!-- Meta Pixel Code -->
    <script is:inline>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod
            ? n.callMethod.apply(n, arguments)
            : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = "2.0";
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(
        window,
        document,
        "script",
        "https://connect.facebook.net/en_US/fbevents.js",
      );
      fbq("init", "1119851420489248");
      fbq("track", "PageView");
      // Only new waitlist entries count as a Lead; no personal data is sent.
      window.addEventListener("hooksage:funnel", (event) => {
        if (event.detail?.event === "generate_lead") fbq("track", "Lead");
      });
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        alt=""
        src="https://www.facebook.com/tr?id=1119851420489248&ev=PageView&noscript=1"
      />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <a class="skip-link hs-btn hs-btn--primary" href="#contenido">
      {t("Saltar al contenido")}
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <FunnelTracking />
  </body>
</html>
