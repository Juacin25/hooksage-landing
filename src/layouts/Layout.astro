---
import "../styles/tokens.css";
import "../styles/components.css";
import "../styles/global.css";
import "../styles/showcase.css";
import "../styles/story-landing.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FunnelTracking from "../components/FunnelTracking.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { contentFor, type faqs } from "../data/content";
import {
  localeFromPath,
  translator,
  alternatePath,
  homePath,
} from "../lib/i18n";
import { plans, packs } from "../data/plan";
import { countries } from "../../server/countries.mjs";
import { business } from "../data/business";
import { contactEmail, paidPlansAvailable } from "../lib/config";
const lang = localeFromPath(Astro.url.pathname);
const analyticsEnabled = import.meta.env.PUBLIC_ENABLE_ANALYTICS !== "false";
const t = translator(lang);
const faqsForLanguage = contentFor(lang).faqs;
interface Props {
  title?: string;
  description?: string;
  faqItems?: typeof faqs;
  variant?: "default" | "story";
  noindex?: boolean;
  // Pages without an English version (the blog) skip hreflang alternates.
  alternates?: boolean;
  // Breadcrumb trail after the home item; defaults to the current page.
  breadcrumbs?: { name: string; url: string }[];
  // Extra JSON-LD nodes for the page (for example BlogPosting).
  schema?: Record<string, unknown>[];
  image?: string;
  ogType?: "website" | "article";
}
const {
  title = lang === "en"
    ? "Turn raw footage into an edited short | Hooksage"
    : "De tu video en crudo a un short editado | Hooksage",
  description = lang === "en"
    ? "Hooksage turns raw recordings into vertical shorts for Reels, TikTok and YouTube Shorts, with automatic cuts, reframing and captions. First edit free."
    : "Hooksage convierte tus grabaciones en videos verticales para Reels, TikTok y Shorts, con cortes, encuadre y subtítulos automáticos. Primera edición gratis.",
  faqItems = faqsForLanguage,
  variant = "default",
  noindex = false,
  alternates = true,
  breadcrumbs,
  schema = [],
  image,
  ogType = "website",
}: Props = Astro.props;
const ogImage =
  image ??
  "https://hooksage.com/" +
    (lang === "en" ? "og-product-en.png" : "og-product.png");
const canonical = new URL(Astro.url.pathname, "https://hooksage.com/").href;
const home = "https://hooksage.com" + homePath(lang);
const offerAvailability = paidPlansAvailable
  ? "https://schema.org/InStock"
  : "https://schema.org/PreOrder";
const price = (value: string) => value.replace(",", ".");
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hooksage.com/#organization",
      name: business.brand,
      legalName: business.legalName,
      taxID: business.taxId,
      email: contactEmail,
      address: {
        "@type": "PostalAddress",
        streetAddress: business.streetAddress,
        addressLocality: business.city,
        addressCountry: business.countryCode,
      },
      url: "https://hooksage.com/",
      logo: "https://hooksage.com/logos/hooksage-logo-512.png",
      areaServed: countries.map((country) => ({
        "@type": "Country",
        name: country.en,
      })),
      ...(business.sameAs.length ? { sameAs: business.sameAs } : {}),
    },
    {
      "@type": "WebSite",
      "@id": "https://hooksage.com/#website",
      url: "https://hooksage.com/",
      name: "Hooksage",
      inLanguage: ["es", "en"],
      publisher: { "@id": "https://hooksage.com/#organization" },
    },
    {
      "@type": "WebPage",
      "@id": canonical + "#webpage",
      url: canonical,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { "@id": "https://hooksage.com/#website" },
      about: { "@id": "https://hooksage.com/#software" },
      ...(canonical !== home
        ? { breadcrumb: { "@id": canonical + "#breadcrumb" } }
        : {}),
    },
    ...(canonical !== home
      ? [
          {
            "@type": "BreadcrumbList",
            "@id": canonical + "#breadcrumb",
            itemListElement: [
              { name: "Hooksage", url: home },
              ...(breadcrumbs ?? [
                { name: title.replace(/ \| Hooksage$/, ""), url: canonical },
              ]),
            ].map((crumb, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: crumb.name,
              item: crumb.url,
            })),
          },
        ]
      : []),
    {
      "@type": "SoftwareApplication",
      "@id": "https://hooksage.com/#software",
      name: "Hooksage",
      url: home,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory:
        lang === "en" ? "AI video editor" : "Editor de video con IA",
      operatingSystem: "Web",
      description:
        lang === "en"
          ? "AI video editor that turns raw recordings into vertical shorts for Reels, TikTok and YouTube Shorts, with cuts, reframing and captions. Exports MP4 720 × 1280 at 30 fps."
          : "Editor de video con IA que convierte grabaciones en videos verticales para Reels, TikTok y YouTube Shorts, con cortes, encuadre y subtítulos. Exporta MP4 de 720 × 1280 a 30 fps.",
      inLanguage: lang,
      publisher: { "@id": "https://hooksage.com/#organization" },
      offers: [
        ...plans.map((plan) => ({
          "@type": "Offer",
          name: plan.name + (lang === "en" ? " (monthly)" : " (mensual)"),
          price: price(plan.monthlyPriceUSD),
          priceCurrency: "USD",
          availability: offerAvailability,
          url: home + "#precio",
        })),
        ...packs.map((pack) => ({
          "@type": "Offer",
          name: pack.name,
          price: price(pack.priceUSD),
          priceCurrency: "USD",
          availability: offerAvailability,
          url: home + "#precio",
        })),
      ],
    },
    ...schema,
    ...(faqItems.length
      ? [
          {
            "@type": "FAQPage",
            mainEntity: faqItems.map(({ question, answer }) => ({
              "@type": "Question",
              name: question,
              acceptedAnswer: { "@type": "Answer", text: answer },
            })),
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html
  lang={lang === "en" ? "en" : "es"}
  data-theme={variant === "story" ? "dark" : undefined}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="color-scheme"
      content={variant === "story" ? "dark" : "light dark"}
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates && (
      <Fragment>
        <link
          rel="alternate"
          hreflang="es"
          href={
            new URL(
              alternatePath(Astro.url.pathname, "es"),
              "https://hooksage.com/",
            ).href
          }
        />
        <link
          rel="alternate"
          hreflang="en"
          href={
            new URL(
              alternatePath(Astro.url.pathname, "en"),
              "https://hooksage.com/",
            ).href
          }
        />
        <link
          rel="alternate"
          hreflang="x-default"
          href={
            new URL(
              alternatePath(Astro.url.pathname, "es"),
              "https://hooksage.com/",
            ).href
          }
        />
      </Fragment>
    )}
    <link rel="icon" href="/logos/hooksage-app-icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_LA"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "es_LA" : "en_US"}
    />
    <meta property="og:locale:alternate" content="en_GB" />
    <meta property="og:site_name" content="Hooksage" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={
        lang === "en"
          ? "Hooksage. More videos. Less time editing. For startups and small teams."
          : "Hooksage. Más videos. Menos horas editando. Startups y pymes de toda Hispanoamérica."
      }
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque-latin-800-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  </head>
  <body class:list={{ "landing--story": variant === "story" }}>
    <a class="skip-link hs-btn hs-btn--primary" href="#contenido">
      {t("Saltar al contenido")}
    </a>
    <Header story={variant === "story"} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CookieConsent enabled={analyticsEnabled} />
    <FunnelTracking />
  </body>
</html>
