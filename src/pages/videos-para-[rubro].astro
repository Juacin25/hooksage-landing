---
import BusinessLanding from "../components/BusinessLanding.astro";
import { businesses } from "../data/content";
export function getStaticPaths() {
  return businesses.map((business) => ({
    params: { rubro: business.slug },
    props: { business },
  }));
}
const { business } = Astro.props;
---

<BusinessLanding business={business} />
